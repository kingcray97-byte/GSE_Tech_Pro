<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================================= -->
    <!-- Typography & Touch Sizing Constants (ARCHITECTURE.md §5.5, AGENTS.md)    -->
    <!-- ======================================================================= -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <x:Double x:Key="MinTouchSize">44</x:Double>
    <Thickness x:Key="TouchButtonPadding">12,8</Thickness>
    <Thickness x:Key="ToolbarButtonMargin">2,2</Thickness>
    <CornerRadius x:Key="AppCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>

    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeSubtitle">16</x:Double>
    <x:Double x:Key="FontSizeHeader">20</x:Double>

    <!-- ======================================================================= -->
    <!-- Theme Dictionaries: Light, Dark, and HighContrast (Sunlight mode)        -->
    <!-- Colors match docs/ARCHITECTURE.md §5.3 exactly.                          -->
    <!-- ======================================================================= -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- Light Theme (Default Windows Light) -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackgroundColor">#F3F3F3</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppToolbarColor">#EBEBEB</Color>
            <Color x:Key="AppRailColor">#23276E</Color>
            <Color x:Key="AppRailTextColor">#FFFFFF</Color>
            <Color x:Key="AppTextPrimaryColor">#1A1A1A</Color>
            <Color x:Key="AppTextSecondaryColor">#5C5C5C</Color>
            <Color x:Key="AppAccentColor">#2E3391</Color>
            <Color x:Key="AppAccentHoverColor">#24286E</Color>
            <Color x:Key="AppOnAccentTextColor">#FFFFFF</Color>
            <Color x:Key="AppSuccessColor">#0F7B0F</Color>
            <Color x:Key="AppWarningColor">#9D5D00</Color>
            <Color x:Key="AppDangerColor">#C42B1C</Color>
            <Color x:Key="DtcActiveColor">#C42B1C</Color>
            <Color x:Key="DtcPendingColor">#2E3391</Color>
            <Color x:Key="DtcStoredColor">#5C5C5C</Color>
            <Color x:Key="AppFocusBorderColor">#2E3391</Color>
            <Color x:Key="AppSubtleBorderColor">#D6D6D6</Color>
            <Color x:Key="AppRowAltColor">#F5F7FC</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppToolbarBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="AppRailBrush" Color="#23276E" />
            <SolidColorBrush x:Key="AppRailTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#2E3391" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#24286E" />
            <SolidColorBrush x:Key="AppOnAccentTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#0F7B0F" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#9D5D00" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DtcActiveBrush" Color="#C42B1C" />
            <SolidColorBrush x:Key="DtcPendingBrush" Color="#2E3391" />
            <SolidColorBrush x:Key="DtcStoredBrush" Color="#5C5C5C" />
            <SolidColorBrush x:Key="AppFocusBorderBrush" Color="#2E3391" />
            <SolidColorBrush x:Key="AppSubtleBorderBrush" Color="#D6D6D6" />
            <SolidColorBrush x:Key="AppRowAltBrush" Color="#F5F7FC" />

            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#2E3391" />
        </ResourceDictionary>

        <!-- Dark Theme (Default Windows Dark) -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackgroundColor">#1C1C1C</Color>
            <Color x:Key="AppSurfaceColor">#2A2A2A</Color>
            <Color x:Key="AppToolbarColor">#242424</Color>
            <Color x:Key="AppRailColor">#181B42</Color>
            <Color x:Key="AppRailTextColor">#FFFFFF</Color>
            <Color x:Key="AppTextPrimaryColor">#FFFFFF</Color>
            <Color x:Key="AppTextSecondaryColor">#A0A0A0</Color>
            <Color x:Key="AppAccentColor">#8C93F0</Color>
            <Color x:Key="AppAccentHoverColor">#A7ADF5</Color>
            <Color x:Key="AppOnAccentTextColor">#1C1C1C</Color>
            <Color x:Key="AppSuccessColor">#6CCB5F</Color>
            <Color x:Key="AppWarningColor">#FCE100</Color>
            <Color x:Key="AppDangerColor">#FF99A4</Color>
            <Color x:Key="DtcActiveColor">#FF99A4</Color>
            <Color x:Key="DtcPendingColor">#8C93F0</Color>
            <Color x:Key="DtcStoredColor">#A0A0A0</Color>
            <Color x:Key="AppFocusBorderColor">#8C93F0</Color>
            <Color x:Key="AppSubtleBorderColor">#3D3D3D</Color>
            <Color x:Key="AppRowAltColor">#232533</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="AppToolbarBrush" Color="#242424" />
            <SolidColorBrush x:Key="AppRailBrush" Color="#181B42" />
            <SolidColorBrush x:Key="AppRailTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#8C93F0" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#A7ADF5" />
            <SolidColorBrush x:Key="AppOnAccentTextBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#6CCB5F" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#FCE100" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DtcActiveBrush" Color="#FF99A4" />
            <SolidColorBrush x:Key="DtcPendingBrush" Color="#8C93F0" />
            <SolidColorBrush x:Key="DtcStoredBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="AppFocusBorderBrush" Color="#8C93F0" />
            <SolidColorBrush x:Key="AppSubtleBorderBrush" Color="#3D3D3D" />
            <SolidColorBrush x:Key="AppRowAltBrush" Color="#232533" />

            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#8C93F0" />
        </ResourceDictionary>

        <!-- HighContrast / Sunlight Mode -->
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="AppBackgroundColor">#FFFFFF</Color>
            <Color x:Key="AppSurfaceColor">#FFFFFF</Color>
            <Color x:Key="AppToolbarColor">#FFFFFF</Color>
            <Color x:Key="AppRailColor">#1E2FB8</Color>
            <Color x:Key="AppRailTextColor">#FFFFFF</Color>
            <Color x:Key="AppTextPrimaryColor">#000000</Color>
            <Color x:Key="AppTextSecondaryColor">#1A1A1A</Color>
            <Color x:Key="AppAccentColor">#1E2FB8</Color>
            <Color x:Key="AppAccentHoverColor">#16228A</Color>
            <Color x:Key="AppOnAccentTextColor">#FFFFFF</Color>
            <Color x:Key="AppSuccessColor">#007100</Color>
            <Color x:Key="AppWarningColor">#8A5200</Color>
            <Color x:Key="AppDangerColor">#B30000</Color>
            <Color x:Key="DtcActiveColor">#B30000</Color>
            <Color x:Key="DtcPendingColor">#1E2FB8</Color>
            <Color x:Key="DtcStoredColor">#1A1A1A</Color>
            <Color x:Key="AppFocusBorderColor">#000000</Color>
            <Color x:Key="AppSubtleBorderColor">#000000</Color>
            <Color x:Key="AppRowAltColor">#EEF1FF</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppToolbarBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppRailBrush" Color="#1E2FB8" />
            <SolidColorBrush x:Key="AppRailTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#000000" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppAccentBrush" Color="#1E2FB8" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#16228A" />
            <SolidColorBrush x:Key="AppOnAccentTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#007100" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#8A5200" />
            <SolidColorBrush x:Key="AppDangerBrush" Color="#B30000" />
            <SolidColorBrush x:Key="DtcActiveBrush" Color="#B30000" />
            <SolidColorBrush x:Key="DtcPendingBrush" Color="#1E2FB8" />
            <SolidColorBrush x:Key="DtcStoredBrush" Color="#1A1A1A" />
            <SolidColorBrush x:Key="AppFocusBorderBrush" Color="#000000" />
            <SolidColorBrush x:Key="AppSubtleBorderBrush" Color="#000000" />
            <SolidColorBrush x:Key="AppRowAltBrush" Color="#EEF1FF" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ======================================================================= -->
    <!-- Glove-friendly Touch Control Styles (44x44 minimum target)               -->
    <!-- ======================================================================= -->
    <Style x:Key="ToolbarButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="54" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="{StaticResource ToolbarButtonMargin}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ToolToggleButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="{StaticResource ToolbarButtonMargin}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="NavRailButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource AppRailTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="ActionTouchButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="{StaticResource MinTouchSize}" />
        <Setter Property="MinWidth" Value="{StaticResource MinTouchSize}" />
        <Setter Property="Padding" Value="{StaticResource TouchButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadius}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    </Style>

</ResourceDictionary>
