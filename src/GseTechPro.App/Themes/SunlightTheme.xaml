            <SolidColorBrush x:Key="ScopeCursorBBrush" Color="#007100" />
            <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#1E2FB8" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
