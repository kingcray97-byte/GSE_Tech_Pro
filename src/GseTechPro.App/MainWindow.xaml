                                                                            <ColumnDefinition Width="36" /><ColumnDefinition Width="72" /><ColumnDefinition Width="80" />
                                                                            <ColumnDefinition Width="200" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="110" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{x:Bind Number}" FontSize="{StaticResource FontSizeSmall}" />
                                                                        <TextBlock Grid.Column="1" Text="{x:Bind Time}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource FontSizeSmall}" />
                                                                        <TextBlock Grid.Column="2" Text="{x:Bind Identifier}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource FontSizeSmall}" />
                                                                        <TextBlock Grid.Column="3" Text="{x:Bind J1939}" FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="4" Text="{x:Bind Dlc}" FontSize="{StaticResource FontSizeSmall}" />
                                                                        <TextBlock Grid.Column="5" Text="{x:Bind Data}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="6" Text="{x:Bind Status}" FontSize="{StaticResource FontSizeSmall}" TextWrapping="Wrap"
                                                                                   FontWeight="{x:Bind StatusWeight}" />
                                                                    </Grid>
                                                                    <TextBlock Text="{x:Bind Decoded}" Margin="42,0,0,0" FontSize="{StaticResource FontSizeSmall}"
                                                                               Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap"
                                                                               Visibility="{x:Bind DecodedVisibility}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <!-- Channel labels (10D.1h): name each channel; saved with the capture -->
                                    <Button Grid.Row="6" Grid.Column="1" Style="{StaticResource ScopeToolTileButtonStyle}"
                                            AutomationProperties.Name="Channel labels">
                                        <StackPanel Spacing="3">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8EC;" FontSize="20" />
                                            <TextBlock Text="Labels" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedBottom">
                                                <StackPanel Width="320" Spacing="8">
                                                    <TextBlock Text="Channel labels" FontWeight="Bold" />
                                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               Text="Name what each channel is connected to. Labels show on the channel tiles and above the trace, and are saved with the capture. Choosing a guided test or opening a saved capture replaces them." />
                                                    <TextBox Header="{x:Bind ViewModel.ScopeChannel1.LabelHeader}"
                                                             MinHeight="{StaticResource MinTouchSize}"
                                                             MaxLength="{x:Bind ViewModel.ScopeChannelLabelMaxLength}"
                                                             PlaceholderText="e.g. Crank sensor"
                                                             Text="{x:Bind ViewModel.ScopeChannel1.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Channel 1 label" />
                                                    <TextBox Header="{x:Bind ViewModel.ScopeChannel2.LabelHeader}"
                                                             MinHeight="{StaticResource MinTouchSize}"
                                                             MaxLength="{x:Bind ViewModel.ScopeChannelLabelMaxLength}"
                                                             PlaceholderText="e.g. Crank sensor"
                                                             Text="{x:Bind ViewModel.ScopeChannel2.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Channel 2 label" />
                                                    <TextBox Header="{x:Bind ViewModel.ScopeChannel3.LabelHeader}"
                                                             MinHeight="{StaticResource MinTouchSize}"
                                                             MaxLength="{x:Bind ViewModel.ScopeChannelLabelMaxLength}"
                                                             PlaceholderText="e.g. Crank sensor"
                                                             Text="{x:Bind ViewModel.ScopeChannel3.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Channel 3 label" />
                                                    <TextBox Header="{x:Bind ViewModel.ScopeChannel4.LabelHeader}"
                                                             MinHeight="{StaticResource MinTouchSize}"
                                                             MaxLength="{x:Bind ViewModel.ScopeChannelLabelMaxLength}"
                                                             PlaceholderText="e.g. Crank sensor"
                                                             Text="{x:Bind ViewModel.ScopeChannel4.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Channel 4 label" />
                                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                            Command="{x:Bind ViewModel.ClearScopeChannelLabelsCommand}" Content="Clear all labels" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <!-- Notes (10D.1i): free text saved with the capture -->
                                    <Button Grid.Row="7" Grid.Column="0" Style="{StaticResource ScopeToolTileButtonStyle}"
                                            AutomationProperties.Name="Capture notes">
                                        <StackPanel Spacing="3">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE70B;" FontSize="20" />
                                            <TextBlock Text="Notes" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedBottom">
                                                <StackPanel Width="400" Spacing="8">
                                                    <TextBlock Text="Capture notes" FontWeight="Bold" />
                                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               Text="What is connected, engine or unit state, what you saw. Saved with the capture by Save to WO; opening a saved capture shows its notes." />
                                                    <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                                                             MaxLength="{x:Bind ViewModel.ScopeNotesMaxLength}"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             PlaceholderText="e.g. Engine idling, A on CKP signal at ECU pin, B on CMP. Dropout every 4th rev."
                                                             Text="{x:Bind ViewModel.ScopeNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="Capture notes text" />
                                                    <Grid>
                                                        <TextBlock Text="{x:Bind ViewModel.ScopeNotesCountText, Mode=OneWay}" VerticalAlignment="Center"
                                                                   FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                        <Button HorizontalAlignment="Right" Style="{StaticResource ActionTouchButtonStyle}"
                                                                Command="{x:Bind ViewModel.ClearScopeNotesCommand}" Content="Clear notes" />
                                                    </Grid>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <!-- Views (10D.1k): one view, or one stacked view per channel -->
                                    <Button Grid.Row="7" Grid.Column="1" Style="{StaticResource ScopeToolTileButtonStyle}"
                                            AutomationProperties.Name="Views">
                                        <StackPanel Spacing="3">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xF0E2;" FontSize="20" />
                                            <TextBlock Text="Views" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedBottom">
                                                <StackPanel Width="320" Spacing="8">
                                                    <TextBlock Text="Views" FontWeight="Bold" />
                                                    <ComboBox HorizontalAlignment="Stretch" MinHeight="{StaticResource MinTouchSize}"
                                                              Header="Layout"
                                                              ItemsSource="{x:Bind ViewModel.ScopeViewLayouts}"
                                                              SelectedItem="{x:Bind ViewModel.SelectedScopeViewLayout, Mode=TwoWay}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeViewsStatusText, Mode=OneWay}"
                                                               TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               Text="Stacked keeps each trace on its own range, so a 5 V sensor and a 100 A clamp do not sit on top of each other. Display only: measurements, rulers and masks are unchanged." />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <!-- Mask (10D.1): pass/fail against a known-good capture -->
                                    <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource ScopeToolTileButtonStyle}"
                                            AutomationProperties.Name="Mask">
                                        <StackPanel Spacing="3">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE73E;" FontSize="20"
                                                      Foreground="{ThemeResource ScopeMaskBrush}" />
                                            <TextBlock Text="Mask" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center"
                                                       TextAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedBottom">
                                                <StackPanel Width="320" Spacing="8">
                                                    <TextBlock Text="Pass/fail mask" FontWeight="Bold" />
                                                    <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               Text="Capture a known-good waveform (use a trigger), enter the tolerance from the test procedure, then Create mask. Later captures at the same timebase and sample rate are checked against it." />
                                                    <ComboBox HorizontalAlignment="Stretch" MinHeight="{StaticResource MinTouchSize}"
                                                              Header="Channel (1 = A … 4 = D)"
                                                              ItemsSource="{x:Bind ViewModel.ScopeMaskChannels}"
                                                              SelectedItem="{x:Bind ViewModel.ScopeMaskChannel, Mode=TwoWay}" />
                                                    <NumberBox MinHeight="{StaticResource MinTouchSize}"
                                                               Header="Voltage tolerance (± V)"
                                                               SpinButtonPlacementMode="Inline" Minimum="0"
                                                               Value="{x:Bind ViewModel.ScopeMaskVoltageTolerance, Mode=TwoWay}" />
                                                    <NumberBox MinHeight="{StaticResource MinTouchSize}"
                                                               Header="Time tolerance (± divisions)"
                                                               SpinButtonPlacementMode="Inline" Minimum="0" SmallChange="0.1"
                                                               Value="{x:Bind ViewModel.ScopeMaskTimeToleranceDivisions, Mode=TwoWay}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                                Command="{x:Bind ViewModel.CreateScopeMaskCommand}" Content="Create mask" />
                                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                                Command="{x:Bind ViewModel.ClearScopeMaskCommand}" Content="Clear" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeMaskCountText, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeMaskStatusText, Mode=OneWay}"
                                                               TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="1" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" MinHeight="260" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Graticule: 10 x 10 dashed divisions, CH A scale left, CH B scale right, time along the bottom -->
                            <Border Grid.Row="0"
                                    Background="{ThemeResource ScopeGridBackgroundBrush}"
                                    BorderBrush="{ThemeResource ScopeTileBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,6,6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,6,4" HorizontalAlignment="Right"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource ScopeChannel1Brush}"
                                               Visibility="{x:Bind ViewModel.ScopeLeftAxisVisibility, Mode=OneWay}">
                                        <Run Text="A " /><Run Text="{x:Bind ViewModel.ScopeLeftAxisUnit, Mode=OneWay}" />
                                    </TextBlock>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="14" Margin="4,0,0,4">
                                        <TextBlock Text="{x:Bind ViewModel.ScopeChannelLabelLegend, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ScopeAxisTextBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="520"
                                                   Visibility="{x:Bind ViewModel.ScopeChannelLabelLegendVisibility, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind ViewModel.ScopeZoomLabel, Mode=OneWay}"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource ScopeAxisTextBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.ScopeReferenceOverlayStatusText, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource ScopeReferenceOverlayBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="6,0,0,4" HorizontalAlignment="Left"
                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource ScopeChannel2Brush}"
                                               Visibility="{x:Bind ViewModel.ScopeRightAxisVisibility, Mode=OneWay}">
                                        <Run Text="B " /><Run Text="{x:Bind ViewModel.ScopeRightAxisUnit, Mode=OneWay}" />
                                    </TextBlock>

                                    <!-- CH A scale (left) -->
                                    <ItemsControl Grid.Row="1" Grid.Column="0" Margin="0,0,6,0"
                                                  ItemsSource="{x:Bind ViewModel.ScopeLeftAxisLabels, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.ScopeLeftAxisVisibility, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:EvenSpacedPanel Orientation="Vertical" CrossAlignment="Right" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" FontSize="{StaticResource FontSizeBadge}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           Foreground="{ThemeResource ScopeChannel1Brush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Graticule grid: unscaled dashed lines at every division (stroke stays 1 px whatever the plot size) -->
                                    <Grid Grid.Row="1" Grid.Column="1" BorderBrush="{ThemeResource ScopeGridLineBrush}" BorderThickness="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Line Grid.Row="1" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Row="2" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Row="3" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Row="4" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Row="5" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridZeroLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Row="6" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Row="7" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Row="8" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Row="9" Grid.ColumnSpan="10" X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" VerticalAlignment="Top" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="1" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="2" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="3" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="4" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="5" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridZeroLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="6" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="7" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="8" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                        <Line Grid.Column="9" Grid.RowSpan="10" X1="0" Y1="0" X2="0" Y2="1" Stretch="Fill" HorizontalAlignment="Left" Stroke="{ThemeResource ScopeGridLineBrush}" StrokeThickness="1" StrokeDashArray="3,3" />
                                    </Grid>

                                    <!-- Plot surface: fixed 1000 x 600 drawing space stretched to fill the view -->
                                    <Viewbox Grid.Row="1" Grid.Column="1" Stretch="Fill">
                                        <Canvas Width="1000" Height="600">

                                            <!-- Reference waveform overlay (dashed, distinct colour) -->
                                            <Polyline Points="{Binding ScopeReferenceOverlayPoints}"
                                                      Stroke="{ThemeResource ScopeReferenceOverlayBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeDashArray="4,2"
                                                      Visibility="{x:Bind ViewModel.ScopeReferenceOverlayVisibility, Mode=OneWay}" />

                                            <!-- CH A-D decimated traces -->
                                            <Polyline Points="{Binding ScopeChannel1Points}"
                                                      Stroke="{ThemeResource ScopeChannel1Brush}" StrokeThickness="1.4"
                                                      Visibility="{x:Bind ViewModel.ScopeChannel1TraceVisibility, Mode=OneWay}" />
                                            <Polyline Points="{Binding ScopeChannel2Points}"
                                                      Stroke="{ThemeResource ScopeChannel2Brush}" StrokeThickness="1.4"
                                                      Visibility="{x:Bind ViewModel.ScopeChannel2TraceVisibility, Mode=OneWay}" />
                                            <Polyline Points="{Binding ScopeChannel3Points}"
                                                      Stroke="{ThemeResource ScopeChannel3Brush}" StrokeThickness="1.4"
                                                      Visibility="{x:Bind ViewModel.ScopeChannel3TraceVisibility, Mode=OneWay}" />
                                            <Polyline Points="{Binding ScopeChannel4Points}"
                                                      Stroke="{ThemeResource ScopeChannel4Brush}" StrokeThickness="1.4"
                                                      Visibility="{x:Bind ViewModel.ScopeChannel4TraceVisibility, Mode=OneWay}" />
                                            <!-- Math channel M (own auto scale) -->
                                            <Polyline Points="{Binding ScopeMathPoints}"
                                                      Stroke="{ThemeResource ScopeMathBrush}" StrokeThickness="1.6"
                                                      Visibility="{x:Bind ViewModel.ScopeMathTraceVisibility, Mode=OneWay}" />
                                            <!-- Mask envelope (upper and lower, on the mask channel's scale) -->
                                            <Polyline Points="{Binding ScopeMaskUpperPoints}"
                                                      Stroke="{ThemeResource ScopeMaskBrush}" StrokeThickness="1" StrokeDashArray="4,2"
                                                      Visibility="{x:Bind ViewModel.ScopeMaskTraceVisibility, Mode=OneWay}" />
                                            <Polyline Points="{Binding ScopeMaskLowerPoints}"
                                                      Stroke="{ThemeResource ScopeMaskBrush}" StrokeThickness="1" StrokeDashArray="4,2"
                                                      Visibility="{x:Bind ViewModel.ScopeMaskTraceVisibility, Mode=OneWay}" />

                                            <!-- Rulers A and B (shown while the Rulers panel is open) -->
                                            <Line X1="{x:Bind ViewModel.ScopeCursorAX, Mode=OneWay}" Y1="0"
                                                  X2="{x:Bind ViewModel.ScopeCursorAX, Mode=OneWay}" Y2="600"
                                                  Stroke="{ThemeResource ScopeCursorABrush}" StrokeThickness="1.5"
                                                  Visibility="{x:Bind ViewModel.ScopeRulerLinesVisibility, Mode=OneWay}" />
                                            <Line X1="{x:Bind ViewModel.ScopeCursorBX, Mode=OneWay}" Y1="0"
                                                  X2="{x:Bind ViewModel.ScopeCursorBX, Mode=OneWay}" Y2="600"
                                                  Stroke="{ThemeResource ScopeCursorBBrush}" StrokeThickness="1.5"
                                                  Visibility="{x:Bind ViewModel.ScopeRulerLinesVisibility, Mode=OneWay}" />
                                        </Canvas>
                                    </Viewbox>

                                    <!-- Stacked views (10D.1k): one lane per trace with its own heading and range -->
                                    <Grid Grid.Row="1" Grid.Column="1" IsHitTestVisible="False"
                                          Visibility="{x:Bind ViewModel.ScopeLaneOverlayVisibility, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{x:Bind ViewModel.ScopeLane1Height, Mode=OneWay}" />
                                            <RowDefinition Height="{x:Bind ViewModel.ScopeLane2Height, Mode=OneWay}" />
                                            <RowDefinition Height="{x:Bind ViewModel.ScopeLane3Height, Mode=OneWay}" />
                                            <RowDefinition Height="{x:Bind ViewModel.ScopeLane4Height, Mode=OneWay}" />
                                            <RowDefinition Height="{x:Bind ViewModel.ScopeLaneMathHeight, Mode=OneWay}" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{ThemeResource ScopeGridZeroLineBrush}" BorderThickness="0,0,0,1">
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" Padding="4,1"
                                                    CornerRadius="3" Background="{ThemeResource ScopeToolbarBrush}">
                                                <TextBlock Text="{x:Bind ViewModel.ScopeLane1Header, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ScopeChannel1Brush}" />
                                            </Border>
                                        </Border>
                                        <Border Grid.Row="1" BorderBrush="{ThemeResource ScopeGridZeroLineBrush}" BorderThickness="0,0,0,1">
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" Padding="4,1"
                                                    CornerRadius="3" Background="{ThemeResource ScopeToolbarBrush}">
                                                <TextBlock Text="{x:Bind ViewModel.ScopeLane2Header, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ScopeChannel2Brush}" />
                                            </Border>
                                        </Border>
                                        <Border Grid.Row="2" BorderBrush="{ThemeResource ScopeGridZeroLineBrush}" BorderThickness="0,0,0,1">
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" Padding="4,1"
                                                    CornerRadius="3" Background="{ThemeResource ScopeToolbarBrush}">
                                                <TextBlock Text="{x:Bind ViewModel.ScopeLane3Header, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ScopeChannel3Brush}" />
                                            </Border>
                                        </Border>
                                        <Border Grid.Row="3" BorderBrush="{ThemeResource ScopeGridZeroLineBrush}" BorderThickness="0,0,0,1">
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" Padding="4,1"
                                                    CornerRadius="3" Background="{ThemeResource ScopeToolbarBrush}">
                                                <TextBlock Text="{x:Bind ViewModel.ScopeLane4Header, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ScopeChannel4Brush}" />
                                            </Border>
                                        </Border>
                                        <Border Grid.Row="4" BorderBrush="{ThemeResource ScopeGridZeroLineBrush}" BorderThickness="0,0,0,1">
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0" Padding="4,1"
                                                    CornerRadius="3" Background="{ThemeResource ScopeToolbarBrush}">
                                                <TextBlock Text="{x:Bind ViewModel.ScopeLaneMathHeader, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ScopeMathBrush}" />
                                            </Border>
                                        </Border>
                                    </Grid>

                                    <!-- Empty-state hint over the plot -->
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="Press Run to capture. Pick a guided test first to load its probe setup and safety warnings."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                                               Foreground="{ThemeResource ScopeAxisTextBrush}"
                                               Visibility="{x:Bind ViewModel.NoScopeCaptureVisibility, Mode=OneWay}" />

                                    <!-- CH B scale (right) -->
                                    <ItemsControl Grid.Row="1" Grid.Column="2" Margin="6,0,0,0"
                                                  ItemsSource="{x:Bind ViewModel.ScopeRightAxisLabels, Mode=OneWay}"
                                                  Visibility="{x:Bind ViewModel.ScopeRightAxisVisibility, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:EvenSpacedPanel Orientation="Vertical" CrossAlignment="Left" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" FontSize="{StaticResource FontSizeBadge}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           Foreground="{ThemeResource ScopeChannel2Brush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Time scale (bottom) -->
                                    <ItemsControl Grid.Row="2" Grid.Column="1" Margin="0,4,0,0"
                                                  ItemsSource="{x:Bind ViewModel.ScopeTimeAxisLabels, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <controls:EvenSpacedPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" FontSize="{StaticResource FontSizeBadge}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           Foreground="{ThemeResource ScopeAxisTextBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Margin="6,4,0,0"
                                               Text="{x:Bind ViewModel.ScopeTimeAxisUnit, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeBadge}"
                                               Foreground="{ThemeResource ScopeAxisTextBrush}" />
                                </Grid>
                            </Border>

                            <!-- Bottom panel: Measurements / Rulers / Guided tests / Waveform library -->
                            <Border Grid.Row="1"
                                    MaxHeight="{x:Bind ViewModel.ScopeBottomPanelMaxHeight, Mode=OneWay}"
                                    Background="{ThemeResource ScopeToolbarBrush}"
                                    BorderBrush="{ThemeResource ScopeTileBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Visibility="{x:Bind ViewModel.ScopeBottomPanelVisibility, Mode=OneWay}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="12,0,0,0" BorderBrush="{ThemeResource ScopeTileBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind ViewModel.ScopeBottomPanelTitle, Mode=OneWay}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Width="44" Height="44" Background="Transparent" BorderThickness="0"
                                                Command="{x:Bind ViewModel.ToggleScopePanelCommand}" CommandParameter="None"
                                                AutomationProperties.Name="Close panel" ToolTipService.ToolTip="Close panel">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE711;" FontSize="14" />
                                        </Button>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <Grid>
                                            <!-- Measurements -->
                                            <Grid Visibility="{x:Bind ViewModel.ScopeMeasurementsPanelVisibility, Mode=OneWay}">
                                                <!-- 5. Measurements & Reference Comparison Panel (WaveformMath + WaveformComparer — ADR-011 §4/§5) -->
                                                <Border Background="{ThemeResource AppSurfaceBrush}"
                                                        BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource CardCornerRadius}">
                                                    <StackPanel>
                                                        <Grid Background="{ThemeResource AppToolbarBrush}"
                                                              Padding="14,10"
                                                              BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                              BorderThickness="0,0,0,1"
                                                              ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                                <TextBlock Text="Deterministic Waveform Measurements &amp; Reference Verdicts"
                                                                           FontSize="{StaticResource FontSizeBody}"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center" />
                                                                <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                                        BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="{StaticResource BadgeCornerRadius}"
                                                                        Padding="6,2"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{x:Bind ViewModel.ScopeSimulatedBadgeVisibility, Mode=OneWay}">
                                                                    <TextBlock Text="SIMULATED"
                                                                               FontSize="{StaticResource FontSizeBadge}"
                                                                               FontWeight="Bold"
                                                                               Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                                </Border>
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{x:Bind ViewModel.ScopeOverallVerdictDisplay, Mode=OneWay}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="{StaticResource FontSizeBody}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{x:Bind ViewModel.ScopeOverallVerdictBrush, Mode=OneWay}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>

                                                        <!-- Table Column Headers -->
                                                        <Grid Background="{ThemeResource AppRowAltBrush}"
                                                              Padding="14,8"
                                                              BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                              BorderThickness="0,0,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="70" />
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="170" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="110" />
                                                                <ColumnDefinition Width="90" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="CH" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                            <TextBlock Grid.Column="1" Text="Measurement" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                            <TextBlock Grid.Column="2" Text="Value / Unit" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                            <TextBlock Grid.Column="3" Text="Status" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                            <TextBlock Grid.Column="4" Text="Provenance" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                            <TextBlock Grid.Column="5" Text="Verdict" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                            <TextBlock Grid.Column="6" Text="Reference Tolerance / Citation Note" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                        </Grid>

                                                        <TextBlock Text="No waveform measurements computed yet. Tap 'Capture' or 'Run Guided Test &amp; Compare' above."
                                                                   Padding="14,16"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                   Visibility="{x:Bind ViewModel.NoScopeMeasurementsVisibility, Mode=OneWay}" />

                                                        <ItemsControl ItemsSource="{x:Bind ViewModel.ScopeMeasurements, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:ScopeMeasurementRowViewModel">
                                                                    <Grid Padding="14,8"
                                                                          MinHeight="{StaticResource MinTouchSize}"
                                                                          BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                                          BorderThickness="0,0,0,1">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="70" />
                                                                            <ColumnDefinition Width="170" />
                                                                            <ColumnDefinition Width="170" />
                                                                            <ColumnDefinition Width="150" />
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="90" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{x:Bind ChannelBadge}"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                                   FontWeight="Bold"
                                                                                   VerticalAlignment="Center" />

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{x:Bind KindDisplay}"
                                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                                   FontWeight="SemiBold"
                                                                                   VerticalAlignment="Center" />

                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{x:Bind ValueAndUnitDisplay}"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                                   FontWeight="Bold"
                                                                                   VerticalAlignment="Center" />

                                                                        <TextBlock Grid.Column="3"
                                                                                   Text="{x:Bind StatusCode}"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                                   VerticalAlignment="Center" />

                                                                        <Border Grid.Column="4"
                                                                                Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                                                BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                                                                Padding="6,2"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{x:Bind SimulatedBadgeVisibility}">
                                                                            <TextBlock Text="SIMULATED"
                                                                                       FontSize="{StaticResource FontSizeBadge}"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                                        </Border>

                                                                        <TextBlock Grid.Column="5"
                                                                                   Text="{x:Bind VerdictBadgeText}"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{x:Bind VerdictBrush}"
                                                                                   VerticalAlignment="Center" />

                                                                        <TextBlock Grid.Column="6"
                                                                                   Text="{x:Bind ToleranceOrReasonDisplay}"
                                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextWrapping="Wrap" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Rulers -->
                                            <StackPanel Padding="12,10" Spacing="10"
                                                        Visibility="{x:Bind ViewModel.ScopeRulersPanelVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.ScopeCursorDeltaLabel, Mode=OneWay}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                <Grid ColumnSpacing="18">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{x:Bind ViewModel.ScopeCursorALabel, Mode=OneWay}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold"
                                                                   Foreground="{ThemeResource ScopeCursorABrush}" TextWrapping="Wrap" />
                                                        <Slider Minimum="0" Maximum="100" Header="Ruler A (%)"
                                                                Value="{x:Bind ViewModel.ScopeCursorAPercent, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{x:Bind ViewModel.ScopeCursorBLabel, Mode=OneWay}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold"
                                                                   Foreground="{ThemeResource ScopeCursorBBrush}" TextWrapping="Wrap" />
                                                        <Slider Minimum="0" Maximum="100" Header="Ruler B (%)"
                                                                Value="{x:Bind ViewModel.ScopeCursorBPercent, Mode=TwoWay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="4">
                                                        <TextBlock Text="{x:Bind ViewModel.ScopeZoomLabel, Mode=OneWay}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                        <Slider Minimum="0" Maximum="100" Header="Pan (%)"
                                                                Value="{x:Bind ViewModel.ScopePanPercent, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Guided tests -->
                                            <StackPanel Padding="12,10" Spacing="10"
                                                        Visibility="{x:Bind ViewModel.ScopeGuidedPanelVisibility, Mode=OneWay}">
                                                <!-- Guided test library (10D.2): topic > subtopic > test, or search every test -->
                                                <Grid ColumnSpacing="10" RowSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBox Grid.Row="0" Grid.ColumnSpan="2" MinHeight="{StaticResource MinTouchSize}"
                                                             PlaceholderText="Search all guided tests (e.g. injector, CAN, ripple)"
                                                             AutomationProperties.Name="Search guided tests"
                                                             Text="{x:Bind ViewModel.ScopeGuidedSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                                               TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               Text="1 Pick a test  ›  2 Read the safety warnings  ›  3 Connect as the procedure says  ›  4 Run guided test &amp; compare" />
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="Topic" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" />
                                                        <ListView Height="176" SelectionMode="Single"
                                                                  BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1"
                                                                  CornerRadius="4"
                                                                  AutomationProperties.Name="Guided test topics"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeGuidedTopics, Mode=OneWay}"
                                                                  SelectedItem="{x:Bind ViewModel.SelectedScopeGuidedTopic, Mode=TwoWay}">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:GuidedTopicItem">
                                                                    <TextBlock Text="{x:Bind DisplayLabel}" TextWrapping="Wrap"
                                                                               VerticalAlignment="Center" MinHeight="{StaticResource MinTouchSize}"
                                                                               Padding="0,12,0,0" />
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="Subtopic" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" />
                                                        <ListView Height="176" SelectionMode="Single"
                                                                  BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1"
                                                                  CornerRadius="4"
                                                                  AutomationProperties.Name="Guided test subtopics"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeGuidedSubtopics, Mode=OneWay}"
                                                                  SelectedItem="{x:Bind ViewModel.SelectedScopeGuidedSubtopic, Mode=TwoWay}">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:GuidedSubtopicItem">
                                                                    <TextBlock Text="{x:Bind DisplayLabel}" TextWrapping="Wrap"
                                                                               VerticalAlignment="Center" MinHeight="{StaticResource MinTouchSize}"
                                                                               Padding="0,12,0,0" />
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                                                        <TextBlock Text="{x:Bind ViewModel.ScopeGuidedTestsHeader, Mode=OneWay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" />
                                                        <ListView Height="176" SelectionMode="Single"
                                                                  BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1"
                                                                  CornerRadius="4"
                                                                  AutomationProperties.Name="Guided tests"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeGuidedBrowserTests, Mode=OneWay}"
                                                                  SelectedItem="{x:Bind ViewModel.SelectedScopeGuidedBrowserTest, Mode=TwoWay}">
                                                            <ListView.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:SelectableGuidedTestItem">
                                                                    <TextBlock Text="{x:Bind DisplayLabel}" TextWrapping="Wrap"
                                                                               VerticalAlignment="Center" MinHeight="{StaticResource MinTouchSize}"
                                                                               Padding="0,12,0,0" />
                                                                </DataTemplate>
                                                            </ListView.ItemTemplate>
                                                        </ListView>
                                                    </StackPanel>
                                                    <Button Grid.Row="1" Grid.Column="3"
                                                            Style="{StaticResource ActionTouchButtonStyle}"
                                                            VerticalAlignment="Bottom"
                                                            Command="{x:Bind ViewModel.RunGuidedScopeTestCommand}"
                                                            Content="Run guided test &amp; compare" />
                                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="4" TextWrapping="Wrap"
                                                               FontSize="{StaticResource FontSizeSmall}" FontStyle="Italic"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               Text="{x:Bind ViewModel.ScopeGuidedSubtopicNote, Mode=OneWay}"
                                                               Visibility="{x:Bind ViewModel.ScopeGuidedSubtopicNoteVisibility, Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                           Text="{x:Bind ViewModel.ScopeGuidedLibraryStatusText, Mode=OneWay}" />
                                                <!-- Guided Test Recipe & Reference Citation Card -->
                                                <Border Background="{ThemeResource AppSurfaceBrush}"
                                                        BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource CardCornerRadius}"
                                                        Padding="14,10"
                                                        Visibility="{x:Bind ViewModel.SelectedGuidedTestVisibility, Mode=OneWay}">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{x:Bind ViewModel.SelectedGuidedTestNameDisplay, Mode=OneWay}"
                                                                       FontSize="{StaticResource FontSizeSubtitle}"
                                                                       FontWeight="Bold" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{x:Bind ViewModel.ActiveReferenceCitationDisplay, Mode=OneWay}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedGuidedTestDescriptionDisplay, Mode=OneWay}"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind ViewModel.SelectedGuidedTestProcedureDisplay, Mode=OneWay}"
                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- One-tap tests (10D.3): test rail | inputs, Start / Analyse, Parameter / Value / Comment -->
                                            <Grid Padding="12,10" ColumnSpacing="12"
                                                  Visibility="{x:Bind ViewModel.ScopeOneTapPanelVisibility, Mode=OneWay}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Test" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" />
                                                    <ListView SelectionMode="Single"
                                                              BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1" CornerRadius="4"
                                                              AutomationProperties.Name="One-tap tests"
                                                              ItemsSource="{x:Bind ViewModel.ScopeOneTapTests}"
                                                              SelectedItem="{x:Bind ViewModel.SelectedScopeOneTapTest, Mode=TwoWay}">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:OneTapTestItem">
                                                                <TextBlock Text="{x:Bind DisplayLabel}" TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" MinHeight="{StaticResource MinTouchSize}"
                                                                           Padding="0,12,0,0" />
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="8">
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeOneTapDescription, Mode=OneWay}" TextWrapping="Wrap"
                                                               FontSize="{StaticResource FontSizeSmall}" />
                                                    <Grid ColumnSpacing="10" RowSpacing="6"
                                                          Visibility="{x:Bind ViewModel.ScopeOneTapBatteryInputsVisibility, Mode=OneWay}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <ComboBox Grid.Row="0" Grid.Column="0" Header="System" MinWidth="96" MinHeight="{StaticResource MinTouchSize}"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeCrankingSystemVoltages}"
                                                                  SelectedItem="{x:Bind ViewModel.ScopeCrankingSystemVoltage, Mode=TwoWay}" />
                                                        <TextBox Grid.Row="0" Grid.Column="1" Header="Current clamp (A/V, blank = none)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="e.g. 1000 for 1 mV/A"
                                                                 Text="{x:Bind ViewModel.ScopeCrankingClampText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Row="0" Grid.Column="2" Header="Battery rating from label (A)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="optional"
                                                                 Text="{x:Bind ViewModel.ScopeCrankingRatedCcaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Grid.Row="0" Grid.Column="3" Header="Rating" MinWidth="110" MinHeight="{StaticResource MinTouchSize}"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeCrankingRatingStandards}"
                                                                  SelectedItem="{x:Bind ViewModel.ScopeCrankingRatingStandard, Mode=TwoWay}" />
                                                        <ComboBox Grid.Row="0" Grid.Column="4" Header="Battery type" HorizontalAlignment="Stretch" MinHeight="{StaticResource MinTouchSize}"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeCrankingBatteryTypes}"
                                                                  SelectedItem="{x:Bind ViewModel.ScopeCrankingBatteryType, Mode=TwoWay}" />
                                                        <TextBox Grid.Row="1" Grid.Column="0" Header="Temp (&#x00B0;C)" MinWidth="96" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="optional"
                                                                 Text="{x:Bind ViewModel.ScopeCrankingTemperatureText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Row="1" Grid.Column="1" Header="Minimum cranking voltage (V)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="only from the manual"
                                                                 Text="{x:Bind ViewModel.ScopeCrankingMinimumVoltsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Header="Source of the minimum (manual, page)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="needed for a pass/fail"
                                                                 Text="{x:Bind ViewModel.ScopeCrankingMinimumSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                                            <Button Style="{StaticResource ActionTouchButtonStyle}" Content="Start"
                                                                    AutomationProperties.Name="Start one-tap test"
                                                                    Command="{x:Bind ViewModel.StartScopeOneTapTestCommand}" />
                                                            <Button MinHeight="{StaticResource MinTouchSize}" MinWidth="88" Content="Analyse"
                                                                    AutomationProperties.Name="Analyse the capture on screen"
                                                                    Command="{x:Bind ViewModel.AnalyseScopeOneTapTestCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid ColumnSpacing="10" RowSpacing="6"
                                                          Visibility="{x:Bind ViewModel.ScopeOneTapCompressionInputsVisibility, Mode=OneWay}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <ComboBox Grid.Row="0" Grid.Column="0" Header="System" MinWidth="96" MinHeight="{StaticResource MinTouchSize}"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeCrankingSystemVoltages}"
                                                                  SelectedItem="{x:Bind ViewModel.ScopeCrankingSystemVoltage, Mode=TwoWay}" />
                                                        <TextBox Grid.Row="0" Grid.Column="1" Header="Current clamp (A/V, blank = none)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="e.g. 1000 for 1 mV/A"
                                                                 Text="{x:Bind ViewModel.ScopeCrankingClampText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Row="0" Grid.Column="2" Header="Cylinders" MinWidth="96" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="required"
                                                                 Text="{x:Bind ViewModel.ScopeCompressionCylindersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Grid.Row="0" Grid.Column="3" Header="Engine cycle" MinWidth="120" MinHeight="{StaticResource MinTouchSize}"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeCompressionEngineCycles}"
                                                                  SelectedItem="{x:Bind ViewModel.ScopeCompressionEngineCycle, Mode=TwoWay}" />
                                                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Maximum spread (%)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="only from the manual"
                                                                 Text="{x:Bind ViewModel.ScopeCompressionMaxSpreadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Header="Source of the maximum (manual, page)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="needed for a pass/fail"
                                                                 Text="{x:Bind ViewModel.ScopeCompressionMaxSpreadSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                                            <Button Style="{StaticResource ActionTouchButtonStyle}" Content="Start"
                                                                    AutomationProperties.Name="Start relative compression test"
                                                                    Command="{x:Bind ViewModel.StartScopeOneTapTestCommand}" />
                                                            <Button MinHeight="{StaticResource MinTouchSize}" MinWidth="88" Content="Analyse"
                                                                    AutomationProperties.Name="Analyse the capture on screen for relative compression"
                                                                    Command="{x:Bind ViewModel.AnalyseScopeOneTapTestCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Grid ColumnSpacing="10" RowSpacing="6"
                                                          Visibility="{x:Bind ViewModel.ScopeOneTapBalanceInputsVisibility, Mode=OneWay}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Grid.Row="0" Grid.Column="0" Header="Cylinders" MinWidth="96" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="required"
                                                                 Text="{x:Bind ViewModel.ScopeCompressionCylindersText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <ComboBox Grid.Row="0" Grid.Column="1" Header="Engine cycle" MinWidth="120" MinHeight="{StaticResource MinTouchSize}"
                                                                  ItemsSource="{x:Bind ViewModel.ScopeCompressionEngineCycles}"
                                                                  SelectedItem="{x:Bind ViewModel.ScopeCompressionEngineCycle, Mode=TwoWay}" />
                                                        <TextBox Grid.Row="0" Grid.Column="2" Header="Wheel teeth, counting missing" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="e.g. 60 for 60-2"
                                                                 Text="{x:Bind ViewModel.ScopeBalanceWheelTeethText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Row="0" Grid.Column="3" Header="Missing teeth" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="e.g. 2 for 60-2, 0 = none"
                                                                 Text="{x:Bind ViewModel.ScopeBalanceMissingTeethText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Header="Maximum spread (%)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="only from the manual"
                                                                 Text="{x:Bind ViewModel.ScopeBalanceMaxSpreadText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBox Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Header="Source of the maximum (manual, page)" MinHeight="{StaticResource MinTouchSize}"
                                                                 PlaceholderText="needed for a pass/fail"
                                                                 Text="{x:Bind ViewModel.ScopeBalanceMaxSpreadSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                                            <Button Style="{StaticResource ActionTouchButtonStyle}" Content="Start"
                                                                    AutomationProperties.Name="Start cylinder balance test"
                                                                    Command="{x:Bind ViewModel.StartScopeOneTapTestCommand}" />
                                                            <Button MinHeight="{StaticResource MinTouchSize}" MinWidth="88" Content="Analyse"
                                                                    AutomationProperties.Name="Analyse the capture on screen for cylinder balance"
                                                                    Command="{x:Bind ViewModel.AnalyseScopeOneTapTestCommand}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeOneTapStatusText, Mode=OneWay}" TextWrapping="Wrap"
                                                               FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" />
                                                    <Border Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                            BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                                                        <StackPanel>
                                                            <Grid Background="{ThemeResource AppRowAltBrush}" Padding="12,6" ColumnSpacing="12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="220" />
                                                                    <ColumnDefinition Width="120" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Parameter" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                                <TextBlock Grid.Column="1" Text="Value" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                                <TextBlock Grid.Column="2" Text="Comment" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" />
                                                            </Grid>
                                                            <TextBlock Text="No result yet. Tap Start, or Analyse to measure the capture on screen."
                                                                       Padding="12,10" FontSize="{StaticResource FontSizeSmall}"
                                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                       Visibility="{x:Bind ViewModel.ScopeOneTapNoResultsVisibility, Mode=OneWay}" />
                                                            <ItemsControl ItemsSource="{x:Bind ViewModel.ScopeOneTapResults}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:OneTapResultRowViewModel">
                                                                        <Grid Padding="12,6" ColumnSpacing="12" MinHeight="{StaticResource MinTouchSize}"
                                                                              BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,1,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="220" />
                                                                                <ColumnDefinition Width="120" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{x:Bind Parameter}" FontWeight="SemiBold"
                                                                                       FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                            <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontFamily="{StaticResource MonoFontFamily}"
                                                                                       FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="2" Text="{x:Bind VerdictText}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold"
                                                                                       VerticalAlignment="Center"
                                                                                       Foreground="{x:Bind VerdictBrush}" Visibility="{x:Bind VerdictVisibility}" />
                                                                            <TextBlock Grid.Column="3" Text="{x:Bind Comment}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                                       FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Waveform library -->
                                            <Grid Visibility="{x:Bind ViewModel.ScopeLibraryPanelVisibility, Mode=OneWay}">
                                                <!-- 6. Saved Waveform Library for Open Work Order (.wfm — ADR-011 §6) -->
                                                <Border Background="{ThemeResource AppSurfaceBrush}"
                                                        BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource CardCornerRadius}">
                                                    <StackPanel>
                                                        <Grid Background="{ThemeResource AppToolbarBrush}"
                                                              Padding="14,10"
                                                              BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                              BorderThickness="0,0,0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" Spacing="2">
                                                                <TextBlock Text="Saved Waveform Library (Active Work Order — .wfm Binary Samples)"
                                                                           FontSize="{StaticResource FontSizeBody}"
                                                                           FontWeight="Bold" />
                                                                <TextBlock Text="Selecting or tapping 'Load .wfm' reloads the binary waveform samples and persisted measurements."
                                                                           FontSize="{StaticResource FontSizeSmall}"
                                                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                            </StackPanel>

                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource ActionTouchButtonStyle}"
                                                                    Command="{x:Bind ViewModel.ReloadWorkOrderWaveformsCommand}"
                                                                    Content="Refresh Waveforms" />
                                                        </Grid>

                                                        <TextBlock Text="No waveforms saved to the active work order yet. Capture a waveform and tap 'Save .wfm to WO'."
                                                                   Padding="14,16"
                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                   Visibility="{x:Bind ViewModel.NoWorkOrderWaveformsVisibility, Mode=OneWay}" />

                                                        <ItemsControl ItemsSource="{x:Bind ViewModel.WorkOrderWaveforms, Mode=OneWay}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:SavedWaveformRowViewModel">
                                                                    <Grid Padding="14,8"
                                                                          MinHeight="{StaticResource MinTouchSize}"
                                                                          BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                                          BorderThickness="0,0,0,1"
                                                                          ColumnSpacing="12">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="220" />
                                                                            <ColumnDefinition Width="180" />
                                                                            <ColumnDefinition Width="140" />
                                                                            <ColumnDefinition Width="110" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{x:Bind GuidedTestName}"
                                                                                   FontSize="{StaticResource FontSizeBody}"
                                                                                   FontWeight="Bold"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />

                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{x:Bind ChannelSummary}"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                                   VerticalAlignment="Center" />

                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{x:Bind SampleCountDisplay}"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                                   VerticalAlignment="Center" />

                                                                        <Border Grid.Column="3"
                                                                                Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                                                BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                                                                Padding="6,2"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{x:Bind SimulatedBadgeVisibility}">
                                                                            <TextBlock Text="{x:Bind ScopeDeviceCode}"
                                                                                       FontSize="{StaticResource FontSizeBadge}"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                                        </Border>

                                                                        <TextBlock Grid.Column="4"
                                                                                   Text="{x:Bind DataPath}"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />

                                                                        <Button Grid.Column="5"
                                                                                Style="{StaticResource ActionTouchButtonStyle}"
                                                                                Tag="{x:Bind}"
                                                                                Click="OnLoadSavedWaveformButtonClick"
                                                                                Content="Load .wfm" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Row 3: scope status line -->
                    <Grid Grid.Row="3"
                          Background="{ThemeResource ScopeToolbarBrush}"
                          BorderBrush="{ThemeResource ScopeTileBorderBrush}"
                          BorderThickness="0,1,0,0"
                          Padding="12,6"
                          ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ScopeStatusMessage, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextTrimming="CharacterEllipsis" />
                            <!-- Pressure channels (10D.4): min / max / mean of the capture on screen -->
                            <TextBlock Text="{x:Bind ViewModel.ScopePressureReadoutText, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                       FontFamily="{StaticResource MonoFontFamily}" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.ScopePressureReadoutVisibility, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ActiveWorkOrderSummaryText, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                   Foreground="{ThemeResource AppAccentBrush}"
                                   MaxWidth="520" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- 3G. TOOL PLACEHOLDER VIEW -->
                <Grid Grid.Row="2"
                      Padding="14,12"
                      Visibility="{x:Bind ViewModel.ToolPlaceholderVisibility, Mode=OneWay}">
                    <Border Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="24">
                        <StackPanel Spacing="12" MaxWidth="680" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.PlaceholderTitle, Mode=OneWay}" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{x:Bind ViewModel.PlaceholderSubtitle, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- =============================================================== -->
                <!-- 3G1. CAMERA (Phase 7.1): take or import a photo, save it to the work order -->
                <!-- =============================================================== -->
                <Grid Grid.Row="2"
                      Padding="16,12"
                      RowSpacing="10"
                      Visibility="{x:Bind ViewModel.CameraViewVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <ComboBox Header="Camera" MinHeight="{StaticResource MinTouchSize}" MinWidth="260"
                                      ItemsSource="{x:Bind ViewModel.CameraSources}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{x:Bind ViewModel.SelectedCameraSource, Mode=TwoWay}" />
                            <Button MinHeight="{StaticResource MinTouchSize}" MinWidth="44" VerticalAlignment="Bottom"
                                    AutomationProperties.Name="Refresh camera list" ToolTipService.ToolTip="Refresh camera list"
                                    Command="{x:Bind ViewModel.RefreshCameraSourcesCommand}">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource ActionTouchButtonStyle}" VerticalAlignment="Bottom" MinWidth="140"
                                    AutomationProperties.Name="Take photo"
                                    Command="{x:Bind ViewModel.TakePhotoCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE722;" FontSize="18" />
                                    <TextBlock Text="Take photo" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button MinHeight="{StaticResource MinTouchSize}" MinWidth="120" VerticalAlignment="Bottom"
                                    AutomationProperties.Name="Import photo from a file"
                                    Command="{x:Bind ViewModel.ImportPhotoCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8B5;" FontSize="16" />
                                    <TextBlock Text="Import..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{x:Bind ViewModel.CameraWorkOrderText, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="1" ColumnSpacing="8" Visibility="{x:Bind ViewModel.PendingPhotoVisibility, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource SimBadgeBackgroundBrush}" BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource BadgeCornerRadius}" Padding="6,2" VerticalAlignment="Bottom"
                                Margin="0,0,0,10"
                                Visibility="{x:Bind ViewModel.PendingPhotoSimulatedVisibility, Mode=OneWay}">
                            <TextBlock Text="SIMULATED" FontSize="{StaticResource FontSizeBadge}" FontWeight="Bold"
                                       Foreground="{ThemeResource SimBadgeTextBrush}" />
                        </Border>
                        <TextBox Grid.Column="1" Header="Caption (what the photo shows)" MinHeight="{StaticResource MinTouchSize}"
                                 PlaceholderText="e.g. Hydraulic leak at lift cylinder, left side" MaxLength="200"
                                 Text="{x:Bind ViewModel.CameraCaption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="2" Style="{StaticResource ActionTouchButtonStyle}" VerticalAlignment="Bottom"
                                Content="Save to work order" AutomationProperties.Name="Save photo to work order"
                                Command="{x:Bind ViewModel.SavePhotoToWorkOrderCommand}" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Photos on this work order" FontWeight="Bold" Padding="12,10" />
                                <TextBlock Grid.Row="1" Padding="12,0" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Text="No photos saved to this work order yet."
                                           Visibility="{x:Bind ViewModel.NoWorkOrderPhotosVisibility, Mode=OneWay}" />
                                <ListView Grid.Row="1" SelectionMode="Single" AutomationProperties.Name="Work order photos"
                                          ItemsSource="{x:Bind ViewModel.WorkOrderPhotos}"
                                          SelectedItem="{x:Bind ViewModel.SelectedWorkOrderPhoto, Mode=TwoWay}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkOrderPhotoRowViewModel">
                                            <StackPanel MinHeight="{StaticResource MinTouchSize}" Padding="0,6" Spacing="2">
                                                <TextBlock Text="{x:Bind Caption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind TakenAtDisplay}" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    <TextBlock Text="SIMULATED" FontSize="{StaticResource FontSizeBadge}" FontWeight="Bold"
                                                               Foreground="{ThemeResource SimBadgeTextBrush}"
                                                               Visibility="{x:Bind SimulatedBadgeVisibility}" />
                                                    <TextBlock Text="{x:Bind MarksSummary}" FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppAccentBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource ScopeGridBackgroundBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource CardCornerRadius}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8" Padding="12,6,8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind ViewModel.CameraPreviewTitle, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{ThemeResource ScopeAxisTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="1" MinHeight="{StaticResource MinTouchSize}" AutomationProperties.Name="Annotate this photo"
                                            Visibility="{x:Bind ViewModel.AnnotateButtonVisibility, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.StartAnnotatingCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xEDC6;" FontSize="16" />
                                            <TextBlock Text="Annotate" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <!-- Pen annotation toolbar (7.2) -->
                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                              Padding="12,0,8,6" Visibility="{x:Bind ViewModel.AnnotationToolbarVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <ComboBox MinHeight="{StaticResource MinTouchSize}" MinWidth="110" AutomationProperties.Name="Annotation tool"
                                                  ItemsSource="{x:Bind ViewModel.AnnotationTools}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedAnnotationTool, Mode=TwoWay}" />
                                        <GridView SelectionMode="Single" AutomationProperties.Name="Annotation colour"
                                                  ItemsSource="{x:Bind ViewModel.AnnotationColorItems}"
                                                  SelectedItem="{x:Bind ViewModel.SelectedAnnotationColorItem, Mode=TwoWay}">
                                            <GridView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </GridView.ItemsPanel>
                                            <GridView.ItemTemplate>
                                                <DataTemplate x:DataType="vm:AnnotationColorItem">
                                                    <Border Width="36" Height="36" CornerRadius="18" BorderThickness="2"
                                                            BorderBrush="{ThemeResource ScopeTileBorderBrush}" Background="{x:Bind Brush}"
                                                            AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" />
                                                </DataTemplate>
                                            </GridView.ItemTemplate>
                                        </GridView>
                                        <Button MinHeight="{StaticResource MinTouchSize}" Content="Undo" Command="{x:Bind ViewModel.UndoAnnotationCommand}" />
                                        <Button MinHeight="{StaticResource MinTouchSize}" Content="Clear" Command="{x:Bind ViewModel.ClearAnnotationsCommand}" />
                                        <Button Style="{StaticResource ActionTouchButtonStyle}" Content="Save marks" Command="{x:Bind ViewModel.SaveAnnotationsCommand}" />
                                        <Button MinHeight="{StaticResource MinTouchSize}" Content="Cancel" Command="{x:Bind ViewModel.CancelAnnotatingCommand}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <!-- Photo and marks share one surface sized to the photo's pixels; the Viewbox fits it on screen. -->
                                <Viewbox Grid.Row="2" Stretch="Uniform" Margin="8">
                                    <Grid x:Name="CameraPhotoSurface" Width="640" Height="480">
                                        <Image x:Name="CameraPreviewImage" Stretch="Fill" AutomationProperties.Name="Photo preview" />
                                        <Canvas x:Name="CameraAnnotationCanvas" Background="Transparent"
                                                AutomationProperties.Name="Photo annotation surface"
                                                PointerPressed="OnAnnotationPointerPressed"
                                                PointerMoved="OnAnnotationPointerMoved"
                                                PointerReleased="OnAnnotationPointerReleased"
                                                PointerCanceled="OnAnnotationPointerReleased"
                                                PointerCaptureLost="OnAnnotationPointerReleased" />
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.CameraStatusText, Mode=OneWay}" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSizeSmall}" />
                </Grid>

                <!-- =============================================================== -->
                <!-- 3G2. CAN CAPTURE > BUS MONITOR (Phase 10C.2, listen-only)       -->
                <!-- =============================================================== -->
                <Grid Grid.Row="2"
                      Padding="16,12"
                      RowSpacing="10"
                      Visibility="{x:Bind ViewModel.CanMonitorViewVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Source + transport bar -->
                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <ComboBox Header="CAN adapter"
                                      MinHeight="{StaticResource MinTouchSize}"
                                      MinWidth="260"
                                      ItemsSource="{x:Bind ViewModel.CanDevices}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCanDevice, Mode=TwoWay}"
                                      DisplayMemberPath="Name" />
                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.RefreshCanDevicesCommand}"
                                    ToolTipService.ToolTip="Look for CAN adapters again">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE72C;" FontSize="16" />
                            </Button>
                            <ComboBox Header="Bit rate (bit/s)"
                                      MinHeight="{StaticResource MinTouchSize}"
                                      MinWidth="150"
                                      ItemsSource="{x:Bind ViewModel.CanBitrates}"
                                      SelectedItem="{x:Bind ViewModel.SelectedCanBitrate, Mode=TwoWay}" />
                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.StartCanMonitorCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE768;" FontSize="16" />
                                    <TextBlock Text="Start" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.StopCanMonitorCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE71A;" FontSize="16" />
                                    <TextBlock Text="Stop" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.ToggleCanRecordingCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7C8;" FontSize="16" Foreground="{ThemeResource DtcActiveBrush}" />
                                    <TextBlock Text="{x:Bind ViewModel.CanRecordButtonText, Mode=OneWay}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                    VerticalAlignment="Bottom"
                                    Command="{x:Bind ViewModel.ClearCanTableCommand}"
                                    Content="Clear" />
                            <TextBox Header="Filter (id, PGN, name, SA xx)"
                                     MinHeight="{StaticResource MinTouchSize}"
                                     Width="240"
                                     PlaceholderText="e.g. F004, EEC1, SA 03"
                                     Text="{x:Bind ViewModel.CanFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource BadgeCornerRadius}"
                                    Padding="10,6"
                                    VerticalAlignment="Bottom"
                                    Visibility="{x:Bind ViewModel.CanSimulatedBadgeVisibility, Mode=OneWay}">
                                <TextBlock Text="SIMULATED" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SimBadgeTextBrush}" />
                            </Border>
                            <Border Background="{ThemeResource RealBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource RealBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource BadgeCornerRadius}"
                                    Padding="10,6"
                                    VerticalAlignment="Bottom"
                                    Visibility="{x:Bind ViewModel.CanRealBadgeVisibility, Mode=OneWay}">
                                <TextBlock Text="REAL · LISTEN-ONLY" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource RealBadgeTextBrush}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Status + counters -->
                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.CanStatusText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CanSelectedDeviceNote, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CanCountersText, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Bus table -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Padding="12,8" ColumnSpacing="10" Background="{ThemeResource AppSubtleBorderBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ID" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="PGN" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="Source" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="DLC" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="5" Text="Data (* = changed)" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="6" Text="Count" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="7" Text="Period" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="8" Text="J1939 decode" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.CanRows}"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CanBusRowViewModel">
                                        <Grid MinHeight="{StaticResource MinTouchSize}" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontFamily="Consolas" Text="{x:Bind IdText, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind FrameKind, Mode=OneWay}" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind PgnText, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind SourceText, Mode=OneWay}" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind DlcText, Mode=OneWay}" />
                                            <TextBlock Grid.Column="5" VerticalAlignment="Center" FontFamily="Consolas" Text="{x:Bind DataWithChangesText, Mode=OneWay}" />
                                            <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{x:Bind CountText, Mode=OneWay}" />
                                            <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{x:Bind PeriodText, Mode=OneWay}" />
                                            <TextBlock Grid.Column="8" VerticalAlignment="Center" Text="{x:Bind DecodedText, Mode=OneWay}" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- Save / export / replay / bus errors -->
                    <Grid Grid.Row="3" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.SaveCanCaptureToWorkOrderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE74E;" FontSize="16" />
                                        <TextBlock Text="Save to work order" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.ExportCanCaptureCommand}"
                                        CommandParameter="asc"
                                        Content="Export .asc" />
                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.ExportCanCaptureCommand}"
                                        CommandParameter="csv"
                                        Content="Export CSV" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox MinHeight="{StaticResource MinTouchSize}"
                                          MinWidth="300"
                                          PlaceholderText="Saved captures (.asc)"
                                          ItemsSource="{x:Bind ViewModel.SavedCanCaptures}"
                                          SelectedItem="{x:Bind ViewModel.SelectedSavedCanCapture, Mode=TwoWay}" />
                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.StartCanReplayCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE768;" FontSize="16" />
                                        <TextBlock Text="Replay" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Bus errors" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.CanBusErrors}" MaxHeight="96" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- =============================================================== -->
                <!-- 3H. SETTINGS (theme, sunlight mode, units, devices, data, about) -->
                <!-- =============================================================== -->
                <ScrollViewer Grid.Row="2"
                              Padding="24,16"
                              Visibility="{x:Bind ViewModel.SettingsViewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Display" FontSize="18" FontWeight="SemiBold" />
                                <RadioButtons x:Name="ThemeRadioButtons"
                                              Header="Theme"
                                              SelectedIndex="0"
                                              SelectionChanged="OnThemeRadioSelectionChanged">
                                    <RadioButton Content="Follow Windows" MinHeight="44" />
                                    <RadioButton Content="Light" MinHeight="44" />
                                    <RadioButton Content="Dark" MinHeight="44" />
                                </RadioButtons>
                                <ToggleSwitch x:Name="SunlightToggleSwitch"
                                              Header="Sunlight mode (high contrast for outdoor ramp work)"
                                              MinHeight="44"
                                              Toggled="OnSunlightToggleSwitchToggled" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Units" FontSize="18" FontWeight="SemiBold" />
                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.ToggleUnitSystemCommand}"
                                        Content="{x:Bind ViewModel.UnitSystemLabel, Mode=OneWay}"
                                        ToolTipService.ToolTip="Switch shop default display units (per-reading overrides are kept)" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="AI service" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Text="Where AI Tech Chat answers come from. This tablet always works offline. The shop server and the cloud are used only when set up and reachable, and fall back to this tablet." />
                                <ComboBox Header="Route preference (any technician)"
                                          MinHeight="{StaticResource MinTouchSize}"
                                          MinWidth="420"
                                          ItemsSource="{x:Bind ViewModel.AiRouteModeLabels}"
                                          SelectedIndex="{x:Bind ViewModel.SelectedAiRouteModeIndex, Mode=TwoWay}" />
                                <TextBlock TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind ViewModel.ChatRouteSummaryText, Mode=OneWay}" />

                                <TextBlock Text="Route status" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.AiRouteStatusLines, Mode=OneWay}" />
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Text="The shop server address and the cloud server are set in the AI service config by the installer (shop_server_url, allow_cloud). Keys live in Windows Credential Manager, never in the app." />

                                <Border BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE72E;" FontSize="16" />
                                            <TextBlock Text="Administrator" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock TextWrapping="Wrap"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   Text="{x:Bind ViewModel.AdminPinHintText, Mode=OneWay}" />
                                        <ToggleSwitch Header="Allow the cloud model when online"
                                                      MinHeight="{StaticResource MinTouchSize}"
                                                      IsOn="{x:Bind ViewModel.AdminCloudAllowedDraft, Mode=TwoWay}" />
                                        <ToggleSwitch Header="Send work order and equipment details to the cloud"
                                                      MinHeight="{StaticResource MinTouchSize}"
                                                      IsEnabled="{x:Bind ViewModel.AdminCloudAllowedDraft, Mode=OneWay}"
                                                      IsOn="{x:Bind ViewModel.AdminShareJobDetailsDraft, Mode=TwoWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PasswordBox Header="Administrator PIN"
                                                         MinHeight="{StaticResource MinTouchSize}"
                                                         Width="200"
                                                         InputScope="NumericPin"
                                                         MaxLength="8"
                                                         Password="{x:Bind ViewModel.AdminPinInput, Mode=TwoWay}" />
                                            <PasswordBox Header="New PIN (4–8 digits)"
                                                         MinHeight="{StaticResource MinTouchSize}"
                                                         Width="200"
                                                         InputScope="NumericPin"
                                                         MaxLength="8"
                                                         Password="{x:Bind ViewModel.AdminNewPinInput, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                    Command="{x:Bind ViewModel.SaveAdminAiSettingsCommand}"
                                                    Content="Save cloud settings" />
                                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                    Command="{x:Bind ViewModel.SetAdminPinCommand}"
                                                    Content="{x:Bind ViewModel.AdminPinActionLabel, Mode=OneWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock TextWrapping="Wrap"
                                           FontWeight="SemiBold"
                                           Visibility="{x:Bind ViewModel.AiRoutingStatusMessageVisibility, Mode=OneWay}"
                                           Text="{x:Bind ViewModel.AiRoutingStatusMessage, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Devices &amp; recording" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource ActionTouchButtonStyle}" Click="OnOpenDeviceSetupDialogClick" Content="Device setup…" />
                                    <Button Style="{StaticResource ActionTouchButtonStyle}" Click="OnDiscoverDevicesClick" Content="Find 32-bit host devices" />
                                    <Button Style="{StaticResource ActionTouchButtonStyle}" Click="OnOpenTriggerSetupClick" Content="Recording trigger…" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Data &amp; about" FontSize="18" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource ActionTouchButtonStyle}" Click="OnReloadDbMenuClick" Content="Reload local database" />
                                    <Button Style="{StaticResource ActionTouchButtonStyle}" Click="OnAboutMenuClick" Content="About GSE Tech Pro" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- =============================================================== -->
                <!-- ROW 3: VCR RECORDING & PLAYBACK TRANSPORT BAR (Screens 13, 17, 18) -->
                <!-- =============================================================== -->
                <Border Grid.Row="3"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8"
                        Visibility="{x:Bind ViewModel.DiagnosticsViewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                                <!-- Record / Stop Recording Button (REC) -->
                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.ToggleRecordingCommand}"
                                        ToolTipService.ToolTip="Start or stop live-data recording to SQLite (RecordingRepository / RecordingFrameRepository)">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7C8;" FontSize="16" Foreground="{ThemeResource DtcActiveBrush}" />
                                        <TextBlock Text="REC / Stop" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <!-- Trigger Setup Button (T — Screen 18) -->
                                <Button Style="{StaticResource VcrTransportButtonStyle}"
                                        Click="OnOpenTriggerSetupClick"
                                        ToolTipService.ToolTip="Trigger Setup (Manual / On-DTC / On-PID Threshold with Pre/Post seconds — Screen 18)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE945;" FontSize="15" />
                                        <TextBlock Text="Trigger (T)" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <AppBarSeparator Margin="4,0" />

                                <!-- VCR Transport Buttons: Play, Pause, Stop/Return to Live, |<<, <<, >>, >>| (Screen 17) -->
                                <Button Style="{StaticResource VcrTransportButtonStyle}"
                                        Command="{x:Bind ViewModel.PlayRecordingCommand}"
                                        ToolTipService.ToolTip="Play Recording">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE768;" FontSize="16" />
                                </Button>

                                <Button Style="{StaticResource VcrTransportButtonStyle}"
                                        Command="{x:Bind ViewModel.PauseRecordingCommand}"
                                        ToolTipService.ToolTip="Pause Playback">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE769;" FontSize="16" />
                                </Button>

                                <Button Style="{StaticResource VcrTransportButtonStyle}"
                                        Command="{x:Bind ViewModel.StopPlaybackAndReturnToLiveCommand}"
                                        ToolTipService.ToolTip="Stop Playback &amp; Return to Live Bus Stream">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE71A;" FontSize="16" />
                                </Button>

                                <Button Style="{StaticResource VcrTransportButtonStyle}"
                                        Command="{x:Bind ViewModel.JumpToStartFrameCommand}"
                                        ToolTipService.ToolTip="Jump to First Frame (|&lt;&lt;)">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE892;" FontSize="16" />
                                </Button>

                                <Button Style="{StaticResource VcrTransportButtonStyle}"
                                        Command="{x:Bind ViewModel.StepBackwardFrameCommand}"
                                        ToolTipService.ToolTip="Step Back 1 Frame (&lt;&lt;)">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE76B;" FontSize="16" />
                                </Button>

                                <Button Style="{StaticResource VcrTransportButtonStyle}"
                                        Command="{x:Bind ViewModel.StepForwardFrameCommand}"
                                        ToolTipService.ToolTip="Step Forward 1 Frame (&gt;&gt;)">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE76C;" FontSize="16" />
                                </Button>

                                <Button Style="{StaticResource VcrTransportButtonStyle}"
                                        Command="{x:Bind ViewModel.JumpToEndFrameCommand}"
                                        ToolTipService.ToolTip="Jump to Last Frame (&gt;&gt;|)">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE893;" FontSize="16" />
                                </Button>

                                <!-- VCR Scrub Slider (Pages frames via GetWindowAsync) -->
                                <Slider x:Name="PlaybackScrubSlider"
                                        Width="220"
                                        Minimum="0"
                                        Maximum="{x:Bind ViewModel.PlaybackMaxSequenceDouble, Mode=OneWay}"
                                        Value="{x:Bind ViewModel.PlaybackSequenceDouble, Mode=OneWay}"
                                        ValueChanged="OnPlaybackSliderValueChanged"
                                        VerticalAlignment="Center"
                                        Margin="8,0" />

                                <!-- Playback Rate Selector -->
                                <ComboBox Width="96"
                                          MinHeight="44"
                                          ItemsSource="{x:Bind ViewModel.PlaybackRates}"
                                          SelectedItem="{x:Bind ViewModel.PlaybackRate, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Playback Speed Multiplier (0.25x – 4x)" />

                                <!-- Saved Recording Session Picker -->
                                <ComboBox Width="230"
                                          MinHeight="44"
                                          ItemsSource="{x:Bind ViewModel.SavedRecordings, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedRecordingSession, Mode=TwoWay}"
                                          DisplayMemberPath="StartedAt"
                                          PlaceholderText="Saved Recordings…"
                                          ToolTipService.ToolTip="Select a saved recording session from SQLite" />

                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.LoadSelectedRecordingForPlaybackCommand}"
                                        Content="Load Replay" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Frame Counter, Trigger Status & Provenance Metadata Strip (Bottom of Screenshots 13 & 17) -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.PlaybackFrameSummary, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       FontSize="12" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.PlaybackMetadataSummary, Mode=OneWay}"
                                       Margin="16,0"
                                       FontSize="12"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.RecordingStatusLabel, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{ThemeResource AppAccentBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- =================================================================== -->
        <!-- ROW 4: STATUS BAR                                                    -->
        <!-- Shows: Adapter/Device, Provenance Badge, MIL, VIN, Protocol, Status  -->
        <!-- =================================================================== -->
        <Border Grid.Row="4"
                Background="{ThemeResource AppToolbarBrush}"
                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6"
                MinHeight="44"
                Visibility="{x:Bind ViewModel.AppChromeVisibility, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Adapter / Device Name + Class (Left) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE950;" FontSize="14" />
                    <TextBlock Text="{x:Bind ViewModel.AdapterDeviceName, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.AdapterKindBadge, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- AI Service Health Status Indicator (ADR-008) -->
                <Border Grid.Column="1"
                        Margin="8,0"
                        Padding="8,2"
                        CornerRadius="{StaticResource BadgeCornerRadius}"
                        Background="{ThemeResource AppSurfaceBrush}"
                        BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8BD;" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.AiStatusIndicatorText, Mode=OneWay}" FontWeight="Bold" FontSize="11" />
                    </StackPanel>
                </Border>


                <!-- MIL Status Badge -->
                <Border Grid.Column="3"
                        Margin="8,0"
                        Padding="8,2"
                        CornerRadius="4"
                        BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="MIL:" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Bind ViewModel.MilStatusText, Mode=OneWay}" FontWeight="Bold" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- VIN -->
                <TextBlock Grid.Column="4"
                           Text="{x:Bind ViewModel.VehicleVinText, Mode=OneWay}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontSize="12" />

                <!-- Protocol -->
                <TextBlock Grid.Column="5"
                           Text="{x:Bind ViewModel.ActiveProtocolText, Mode=OneWay}"
                           Margin="12,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="12" />

                <!-- Connection Status -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Status:" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.ConnectionStatusText, Mode=OneWay}" FontWeight="Bold" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
