<Window
    x:Class="GseTechPro.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:GseTechPro.App.ViewModels"
    xmlns:models="using:GseTechPro.Core.Models"
    xmlns:contracts="using:GseTechPro.Core.Contracts"
    xmlns:controls="using:GseTechPro.App.Controls"
    mc:Ignorable="d"
    Title="GSE Tech Pro — Ground Support Equipment &amp; Heavy-Duty Diagnostics">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <!-- Row 0: Menu bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Icon toolbar (document tools, Current User, modules) -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Document tabs (one per open work order) -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Navy module menu + page -->
            <RowDefinition Height="*" />
            <!-- Row 4: Status bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- =================================================================== -->
        <!-- ROW 0: MENU BAR (Shop Foreman Pro: File Edit View Tools Data Setup  -->
        <!-- Help). Items reuse the toolbar/page routing (Tag = page key).        -->
        <!-- =================================================================== -->
        <Grid Grid.Row="0" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1"
              Visibility="{x:Bind ViewModel.AppChromeVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <MenuBar Grid.Column="0" MinHeight="40">
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="New Work Order" Tag="New" Click="OnToolbarButtonClick" />
                    <MenuFlyoutItem Text="Open Work Order…" Tag="Open" Click="OnToolbarButtonClick" />
                    <MenuFlyoutItem Text="Equipment Registry" Tag="Home" Click="OnToolbarButtonClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Save" Tag="Save" Click="OnToolbarButtonClick" />
                    <MenuFlyoutItem Text="Print…" Tag="Print" Click="OnToolbarButtonClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Reload Database" Click="OnReloadDbMenuClick" />
                </MenuBarItem>
                <MenuBarItem Title="Edit">
                    <MenuFlyoutItem Text="Edit Snaplist" Tag="EditSnaplist" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Custom Display" Tag="CustomDisplay" Click="OnNavRailButtonClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Notes" Tag="Notes" Click="OnToolbarButtonClick" />
                </MenuBarItem>
                <MenuBarItem Title="View">
                    <MenuFlyoutItem Text="Equipment Health" Tag="Diagnostics" Click="OnToolbarButtonClick" />
                    <MenuFlyoutItem Text="Live Data" Tag="LiveData" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Graph" Tag="GraphView" Click="OnNavRailButtonClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Switch Imperial / Metric Units" Command="{x:Bind ViewModel.ToggleUnitSystemCommand}" />
                    <MenuFlyoutItem Text="Theme and Sunlight Mode…" Tag="Settings" Click="OnToolbarButtonClick" />
                </MenuBarItem>
                <MenuBarItem Title="Tools">
                    <MenuFlyoutItem Text="Connect Adapter" Command="{x:Bind ViewModel.ConnectSimulatorCommand}" />
                    <MenuFlyoutItem Text="Disconnect Adapter" Command="{x:Bind ViewModel.DisconnectSimulatorCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Read DTCs" Command="{x:Bind ViewModel.RefreshDiagnosticsCommand}" />
                    <MenuFlyoutItem Text="Clear DTCs…" Command="{x:Bind ViewModel.ClearDtcsCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Oscilloscope" Tag="Scope" Click="OnToolbarButtonClick" />
                    <MenuFlyoutItem Text="CAN Capture" Tag="CanCapture" Click="OnToolbarButtonClick" />
                    <MenuFlyoutItem Text="Camera" Tag="Camera" Click="OnToolbarButtonClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="AI Tech Chat" Tag="AiChat" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Repair Recommendations" Tag="Recommendations" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Guided Troubleshooting" Tag="GuidedTree" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Manual Readings" Tag="Readings" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Manual Search" Tag="ManualSearch" Click="OnNavRailButtonClick" />
                </MenuBarItem>
                <MenuBarItem Title="Data">
                    <MenuFlyoutItem Text="Trouble Codes" Tag="DTCs" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Freeze Frames" Tag="FreezeFrames" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Readiness" Tag="Readiness" Click="OnNavRailButtonClick" />
                    <MenuFlyoutItem Text="Monitors" Tag="Monitors" Click="OnNavRailButtonClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Trigger Setup…" Click="OnOpenTriggerSetupClick" />
                </MenuBarItem>
                <MenuBarItem Title="Setup">
                    <MenuFlyoutItem Text="Scan Tool / VCI Setup…" Click="OnOpenDeviceSetupDialogClick" />
                    <MenuFlyoutItem Text="Find 32-bit Devices" Click="OnDiscoverDevicesClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="AI Service…" Tag="Settings" Click="OnToolbarButtonClick" />
                    <MenuFlyoutItem Text="Settings…" Tag="Settings" Click="OnToolbarButtonClick" />
                </MenuBarItem>
                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="About GSE Tech Pro" Click="OnAboutMenuClick" />
                </MenuBarItem>
            </MenuBar>

            <!-- Data source badge (always shown when values are simulated or real) and units -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Padding="8,0" VerticalAlignment="Center">
                <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                        BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="{StaticResource BadgeCornerRadius}"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.SimulatedBannerVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SimBadgeTextBrush}" />
                        <TextBlock Text="SIMULATED" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource SimBadgeTextBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource RealBadgeBackgroundBrush}"
                        BorderBrush="{ThemeResource RealBadgeBorderBrush}"
                        BorderThickness="1.5"
                        CornerRadius="{StaticResource BadgeCornerRadius}"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.RealHardwareBannerVisibility, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource RealBadgeTextBrush}" />
                        <TextBlock Text="REAL HARDWARE" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource RealBadgeTextBrush}" />
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource ActionTouchButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleUnitSystemCommand}"
                        Content="{x:Bind ViewModel.UnitSystemLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="Switch display units between Imperial and Metric (stored values stay in SI)" />
            </StackPanel>
        </Grid>

        <!-- =================================================================== -->
        <!-- ROW 1: ICON TOOLBAR (Shop Foreman Pro order: New Open Search Save    -->
        <!-- Print Home | Current User | modules | context). Segoe Fluent icons   -->
        <!-- in colour-coded tiles, no vendor art (AGENTS.md rule 12).            -->
        <!-- =================================================================== -->
        <Border Grid.Row="1"
                Background="{ThemeResource AppToolbarBrush}"
                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4"
                Visibility="{x:Bind ViewModel.AppChromeVisibility, Mode=OneWay}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled"
                              VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="New" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="New" ToolTipService.ToolTip="New work order">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE710;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="New" HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Open" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Open" ToolTipService.ToolTip="Open a work order (work order list)">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8E5;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Open" HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Search" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Search" ToolTipService.ToolTip="Search work orders and equipment">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE721;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Search" HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Save" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Save" ToolTipService.ToolTip="Save">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE74E;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Save" HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Print" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Print" ToolTipService.ToolTip="Print report">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE749;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Print" HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Home" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Home" ToolTipService.ToolTip="Home: equipment registry">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE80F;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Home" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'Equipment Registry'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <AppBarSeparator Margin="4,6" />
                        <StackPanel Spacing="2" VerticalAlignment="Center" Margin="6,0">
                            <TextBlock Text="Current User" FontSize="12" HorizontalAlignment="Center" />
                            <ComboBox MinWidth="190"
                                      MinHeight="44"
                                      PlaceholderText="Technician"
                                      AutomationProperties.Name="Current user"
                                      ToolTipService.ToolTip="Current technician"
                                      ItemsSource="{x:Bind ViewModel.AvailableTechnicians, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedTechnician, Mode=TwoWay}" />
                        </StackPanel>
                        <AppBarSeparator Margin="4,6" />
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Click="OnOpenDeviceSetupDialogClick"
                                AutomationProperties.Name="VCI" ToolTipService.ToolTip="Vehicle communication interface: J2534 / RP1210 / simulator setup">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileModuleBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE950;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="VCI" HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Diagnostics" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Scan" ToolTipService.ToolTip="Scan: equipment health, codes and live data">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileModuleBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE9D9;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Scan" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'Diagnostics'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="HeavyDuty" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="J1939" ToolTipService.ToolTip="Heavy duty J1939 / J1708 diagnostics">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileModuleBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7EC;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="J1939" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'Heavy Duty'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="OBDII" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="OBD II" ToolTipService.ToolTip="Global OBD II diagnostics">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileModuleBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE804;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="OBD II" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'OBD II'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Scope" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Scope" ToolTipService.ToolTip="Oscilloscope and guided tests">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileScopeBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE9D2;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Scope" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'Scope'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="CanCapture" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="CAN" ToolTipService.ToolTip="CAN bus capture">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileScopeBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE968;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="CAN" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'CAN Capture'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Camera" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Camera" ToolTipService.ToolTip="Camera and markup">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileScopeBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE722;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Camera" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'Camera'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="AiTechChat" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="AI Chat" ToolTipService.ToolTip="AI tech chat, troubleshooting and manuals">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileAiBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8BD;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="AI Chat" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'AI Tech Chat'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <AppBarSeparator Margin="4,6" />
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="WorkOrders" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="List" ToolTipService.ToolTip="Work order list">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8FD;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="List" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'Work Orders'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Notes" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Notes" ToolTipService.ToolTip="Work order and technician notes">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE70B;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Notes" HorizontalAlignment="Center" FontSize="12" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarTileButtonStyle}" Tag="Settings" Click="OnToolbarButtonClick"
                                AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings: display, units and devices">
                            <Grid RowSpacing="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Center"
                                        Background="{ThemeResource ToolTileDocBrush}">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE713;" FontSize="16"
                                              Foreground="{ThemeResource ToolTileGlyphBrush}" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="Settings" HorizontalAlignment="Center" FontSize="12" />
                                <Rectangle Grid.Row="2" Height="3" Width="28" RadiusX="1.5" RadiusY="1.5" Fill="{ThemeResource AppAccentBrush}" Visibility="{x:Bind vm:MainShellViewModel.ToolbarIndicator(ViewModel.ActiveTool, 'Settings'), Mode=OneWay}" />
                            </Grid>
                        </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WORK ORDER TABS: one per open work order (Shop Foreman Pro document tabs) -->
        <Border Grid.Row="2"
                Background="{ThemeResource AppSurfaceBrush}"
                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,2"
                Visibility="{x:Bind ViewModel.TabStripVisibility, Mode=OneWay}">
            <ListView ItemsSource="{x:Bind ViewModel.OpenTabs, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
                      SelectionMode="Single"
                      AutomationProperties.Name="Open work orders"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpenWorkOrderTab">
                        <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="40" Padding="4,0" VerticalAlignment="Center">
                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8A5;" FontSize="14" />
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind AssetNumber}" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- ROW 3: navy module menu (inside modules only) + page -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- MODULE MENU: the active module's pages (Shop Foreman Pro's navy left menu) -->
            <Border Grid.Column="0"
                    Width="232"
                    Background="{ThemeResource ModuleNavBrush}"
                    RequestedTheme="Dark"
                    Visibility="{x:Bind ViewModel.ModuleNavVisibility, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" Padding="16,14,12,10">
                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="{x:Bind ViewModel.ModuleNavGlyph, Mode=OneWay}"
                                  FontSize="18" Foreground="{ThemeResource SectionTileTextBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.ModuleNavTitle, Mode=OneWay}" FontSize="16" FontWeight="Bold"
                                   Foreground="{ThemeResource SectionTileTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.CurrentModuleNavItems, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedModuleNavItem, Mode=TwoWay}"
                              SelectionMode="Single"
                              AutomationProperties.Name="Module pages"
                              Padding="4,0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SidebarItem">
                                <StackPanel Orientation="Horizontal" Spacing="12" MinHeight="48">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="{x:Bind Glyph}" FontSize="18"
                                              VerticalAlignment="Center" Foreground="{ThemeResource SectionTileTextBrush}" />
                                    <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="{ThemeResource SectionTileTextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="2"
                               Text="{x:Bind ViewModel.ShopNameText, Mode=OneWay}"
                               Margin="16,8,16,12"
                               FontSize="12"
                               Opacity="0.8"
                               Foreground="{ThemeResource SectionTileTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <!-- PAGE AREA (Header + page command bar + Active View + VCR Bar) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Row 0: Header and the current section's command bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 1: Work order tabs -->
                    <RowDefinition Height="Auto" />
                    <!-- Row 2: Active Screen Content -->
                    <RowDefinition Height="*" />
                    <!-- Row 3: VCR Recording & Playback Transport Bar -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Visibility="{x:Bind ViewModel.AppChromeVisibility, Mode=OneWay}">
                    <!-- HEADER: where you are · status · data source badge · technician -->
                    <Border Background="{ThemeResource AppToolbarBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,6">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Diagnostic module frame (10B.3): first breadcrumb part links back to Equipment Selection -->
                                <HyperlinkButton Content="{x:Bind ViewModel.BreadcrumbRoot, Mode=OneWay}"
                                                 Command="{x:Bind ViewModel.OpenBreadcrumbRootCommand}"
                                                 MinHeight="44"
                                                 Padding="4,0"
                                                 FontSize="15"
                                                 Visibility="{x:Bind ViewModel.ModuleFrameVisibility, Mode=OneWay}"
                                                 AutomationProperties.Name="Back to equipment selection" />
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE76C;" FontSize="10"
                                          Foreground="{ThemeResource AppTextSecondaryBrush}"
                                          Visibility="{x:Bind ViewModel.ModuleFrameVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.BreadcrumbCategory, Mode=OneWay}"
                                           FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE76C;" FontSize="10"
                                          Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.BreadcrumbLeaf, Mode=OneWay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.StatusBannerMessage, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />

                        </Grid>
                    </Border>

                    <!-- CONNECTION STRIP (10B.3 diagnostic module frame, SFP's "No Vehicle Connection"):  -->
                    <!-- Scan / CAN / guided pages show the adapter, Scope shows the scope; right side = WO -->
                    <Border Background="{ThemeResource ModuleContentBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,4"
                            MinHeight="36"
                            Visibility="{x:Bind ViewModel.ModuleFrameVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                        AutomationProperties.LiveSetting="Polite">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE703;" FontSize="14"
                                          Foreground="{ThemeResource AppSuccessBrush}"
                                          Visibility="{x:Bind ViewModel.ModuleConnectedVisibility, Mode=OneWay}" />
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7BA;" FontSize="14"
                                          Foreground="{ThemeResource AppWarningBrush}"
                                          Visibility="{x:Bind ViewModel.ModuleDisconnectedVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.ModuleConnectionText, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource AppTextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.ModuleWorkOrderText, Mode=OneWay}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- DIAGNOSTICS / CAN COMMAND BAR: adapter, protocol, connect, DTC actions -->
                    <Border Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,6"
                            Visibility="{x:Bind ViewModel.DeviceCommandBarVisibility, Mode=OneWay}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ComboBox MinWidth="260"
                                          MinHeight="44"
                                          PlaceholderText="Adapter"
                                          ItemsSource="{x:Bind ViewModel.AvailableDevices, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDevice, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Adapter: in-process simulator or 32-bit host J2534/RP1210 device" />

                                <ComboBox MinWidth="120"
                                          MinHeight="44"
                                          PlaceholderText="Protocol"
                                          ItemsSource="{x:Bind ViewModel.SimulatorProtocols}"
                                          SelectedItem="{x:Bind ViewModel.SelectedProtocol, Mode=TwoWay}"
                                          ToolTipService.ToolTip="Protocol (OBD II, J1939, J1708)" />

                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Click="OnOpenDeviceSetupDialogClick"
                                        ToolTipService.ToolTip="Scan tool and J2534/RP1210 device setup">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE713;" FontSize="16" />
                                </Button>

                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.ConnectSimulatorCommand}"
                                        Visibility="{x:Bind ViewModel.ConnectButtonVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE703;" FontSize="16" />
                                        <TextBlock Text="Connect" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.DisconnectSimulatorCommand}"
                                        Visibility="{x:Bind ViewModel.DisconnectButtonVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE711;" FontSize="16" />
                                        <TextBlock Text="Disconnect" />
                                    </StackPanel>
                                </Button>

                                <AppBarSeparator Margin="4,0" />

                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.RefreshDiagnosticsCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE72C;" FontSize="16" />
                                        <TextBlock Text="Read DTCs" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.ClearDtcsCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE74D;" FontSize="16" />
                                        <TextBlock Text="Clear DTCs" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                </StackPanel>


                <!-- =============================================================== -->
                <!-- 3A. DIAGNOSTICS / EQUIPMENT HEALTH & MULTI-VIEW LIVE DATA        -->
                <!-- Matches Screenshots 04, 07, 08, 09, 13, 14, 15, 16               -->
                <!-- =============================================================== -->
                <ScrollViewer Grid.Row="2"
                              Padding="14,12"
                              Visibility="{x:Bind ViewModel.DiagnosticsViewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="14">

                        <!-- ======================================================= -->
                        <!-- SECTION 1: DTC TABLE (Screenshot 04 top table)           -->
                        <!-- Enriched via dtc_library (protocol, code) lookup         -->
                        <!-- Active/Confirmed = Red, Pending/Inactive = Blue (Â§5.3)   -->
                        <!-- ======================================================= -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Visibility="{x:Bind ViewModel.DtcSectionVisibility, Mode=OneWay}">
                            <StackPanel>
                                <!-- Table Header Bar -->
                                <Grid Background="{ThemeResource AppToolbarBrush}" Padding="12,10" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="165" />
                                        <ColumnDefinition Width="45" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="165" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="DTC / Raw ID" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="FF" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Text="Trouble Code Description &amp; Library Citation" FontWeight="Bold" />
                                    <TextBlock Grid.Column="3" Text="System / Library" FontWeight="Bold" />
                                    <TextBlock Grid.Column="4" Text="Provenance" FontWeight="Bold" />
                                    <TextBlock Grid.Column="5" Text="DTC Type / Status" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Empty State when not connected -->
                                <TextBlock Text="No DTCs loaded. Click 'Connect' above to read J1939, J1708, or OBD II trouble codes and enrich against dtc_library."
                                           Padding="14,16"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.NoDtcsVisibility, Mode=OneWay}" />

                                <!-- DTC Rows (Colored per Shop Foreman Pro convention: Red = Active, Blue = Pending/Stored) -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Dtcs, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DtcRowViewModel">
                                            <Grid Padding="12,10" MinHeight="48" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="165" />
                                                    <ColumnDefinition Width="45" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="135" />
                                                    <ColumnDefinition Width="165" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Code}" Foreground="{x:Bind RowBrush}" FontWeight="Bold" />
                                                    <TextBlock Text="{x:Bind RawIdentifiers}" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="11" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{x:Bind HasFreezeFrame}" Foreground="{x:Bind RowBrush}" FontWeight="Bold" VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Padding="0,0,12,0">
                                                    <TextBlock Text="{x:Bind Description}" Foreground="{x:Bind RowBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind LikelyCauses}" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind SourceCitation}" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="11" Opacity="0.85" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind SystemName}" Foreground="{x:Bind RowBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind LibraryMatchLabel}" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="11" />
                                                </StackPanel>

                                                <Border Grid.Column="4"
                                                        Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource BadgeCornerRadius}"
                                                        Padding="8,2"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind SimulatedBadgeVisibility}">
                                                    <TextBlock Text="SIMULATED" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                </Border>

                                                <TextBlock Grid.Column="5" Text="{x:Bind StatusLabel}" Foreground="{x:Bind RowBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================= -->
                        <!-- SECTION 2: LIVE DATA MULTI-VIEW (Screenshots 13–16)      -->
                        <!-- List, Snaplist Editor, Bar, Digital Meter, Analog Gauge, -->
                        <!-- Line Graph with Dual Cursors, Custom Display Builder     -->
                        <!-- ======================================================= -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Visibility="{x:Bind ViewModel.LiveDataSectionVisibility, Mode=OneWay}">
                            <StackPanel>
                                <!-- Live Data Mode Selector Bar -->
                                <Grid Background="{ThemeResource AppToolbarBrush}" Padding="12,8" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SnaplistName, Mode=OneWay}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                                Padding="8,2"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind ViewModel.SimulatedBannerVisibility, Mode=OneWay}">
                                            <TextBlock Text="SIMULATED STREAM" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Touch-friendly View Format Switcher Buttons (44px height) -->
                                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Data Format:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                                            <ComboBox MinWidth="175"
                                                      MinHeight="44"
                                                      ItemsSource="{x:Bind ViewModel.LiveDataDisplayModes}"
                                                      SelectedItem="{x:Bind ViewModel.SelectedLiveDataMode, Mode=TwoWay}"
                                                      ToolTipService.ToolTip="Switch between List, Snaplist Editor, Bar, Digital Meter, Analog Gauge, Line Graph, and Custom Display" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                                <TextBlock Text="No live data streaming. Connect to an adapter or play back a recording to view PIDs."
                                           Padding="14,16"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.NoLivePidsVisibility, Mode=OneWay}" />

                                <!-- MODE A: DENSE LIST VIEW WITH PER-READING UNIT SWITCHER (Screenshots 04 & 13) -->
                                <StackPanel Visibility="{x:Bind ViewModel.LiveListModeVisibility, Mode=OneWay}">
                                    <Grid Background="{ThemeResource AppBackgroundBrush}" Padding="12,8" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="165" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Current Data Parameter (PID / SPN)" FontWeight="Bold" />
                                        <TextBlock Grid.Column="1" Text="Value" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="Units" FontWeight="Bold" Margin="14,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="Per-Reading Unit" FontWeight="Bold" />
                                        <TextBlock Grid.Column="4" Text="Provenance" FontWeight="Bold" />
                                        <TextBlock Grid.Column="5" Text="Canonical SI / Entered" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SnaplistPids, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LivePidRowViewModel">
                                                <Grid Padding="12,6" MinHeight="48" Background="{ThemeResource AppRowAltBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="135" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="165" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="220" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{x:Bind DisplayUnit, Mode=OneWay}" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="3"
                                                              MinHeight="44"
                                                              MinWidth="148"
                                                              ItemsSource="{x:Bind AvailableUnits}"
                                                              SelectedItem="{x:Bind SelectedUnitOverride, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              ToolTipService.ToolTip="Switch display unit for this reading (preserves entered unit)" />
                                                    <Border Grid.Column="4"
                                                            Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BadgeCornerRadius}"
                                                            Padding="6,2"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Visibility="{x:Bind SimulatedBadgeVisibility, Mode=OneWay}">
                                                        <TextBlock Text="SIMULATED" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                    </Border>
                                                    <TextBlock Grid.Column="5" Text="{x:Bind CanonicalSourceDisplay, Mode=OneWay}" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- MODE B: SNAPLIST EDITOR / CUSTOM LIST BUILDER (Screenshot 14) -->
                                <StackPanel Padding="14" Spacing="12" Visibility="{x:Bind ViewModel.SnaplistEditorModeVisibility, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Custom Snaplist Parameter Editor (Matches Screenshot 14)" FontSize="16" FontWeight="Bold" />
                                            <TextBlock Text="Check parameters to include in your Custom Snaplist, then click 'Save &amp; Return'." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                    Command="{x:Bind ViewModel.SelectAllSnaplistPidsCommand}"
                                                    Content="Select All" />
                                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                    Command="{x:Bind ViewModel.DeselectAllSnaplistPidsCommand}"
                                                    Content="Deselect All" />
                                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                    Command="{x:Bind ViewModel.SaveAndReturnSnaplistCommand}"
                                                    Content="Save &amp; Return" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.LivePids, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LivePidRowViewModel">
                                                <Border Padding="10,6" MinHeight="48" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0"
                                                                  MinHeight="44"
                                                                  IsChecked="{x:Bind IsSelectedInSnaplist, Mode=TwoWay}"
                                                                  Content="{x:Bind Name}"
                                                                  FontWeight="SemiBold" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind DisplayValue, Mode=OneWay}" FontWeight="Bold" />
                                                            <TextBlock Text="{x:Bind DisplayUnit, Mode=OneWay}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- MODE C: BAR GRAPH VIEW -->
                                <StackPanel Padding="14" Spacing="10" Visibility="{x:Bind ViewModel.BarGraphModeVisibility, Mode=OneWay}">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SnaplistPids, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LivePidRowViewModel">
                                                <Border Padding="12,10" Margin="0,0,0,8" CornerRadius="{StaticResource AppCornerRadius}" Background="{ThemeResource AppRowAltBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="15" />
                                                                <Border Background="{ThemeResource SimBadgeBackgroundBrush}" BorderBrush="{ThemeResource SimBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Visibility="{x:Bind SimulatedBadgeVisibility, Mode=OneWay}">
                                                                    <TextBlock Text="SIMULATED" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{x:Bind DisplayValue, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="16" />
                                                                <TextBlock Text="{x:Bind DisplayUnit, Mode=OneWay}" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind NormalizedPercent, Mode=OneWay}" Height="18" CornerRadius="4" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind ObservedMinDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ObservedMaxDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- MODE D: DIGITAL METER VIEW -->
                                <StackPanel Padding="14" Visibility="{x:Bind ViewModel.DigitalMeterModeVisibility, Mode=OneWay}">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SnaplistPids, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LivePidRowViewModel">
                                                <Border Width="280" Margin="6" Padding="14" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource AppRowAltBrush}" BorderBrush="{ThemeResource AppFocusBorderBrush}" BorderThickness="1.5">
                                                    <StackPanel Spacing="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1" Background="{ThemeResource SimBadgeBackgroundBrush}" BorderBrush="{ThemeResource SimBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" Visibility="{x:Bind SimulatedBadgeVisibility, Mode=OneWay}">
                                                                <TextBlock Text="SIM" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                            </Border>
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                            <TextBlock Text="{x:Bind DisplayValue, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="{StaticResource FontSizeMeterValue}" FontWeight="Bold" Foreground="{ThemeResource AppAccentBrush}" />
                                                            <TextBlock Text="{x:Bind DisplayUnit, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                                        </StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind ObservedMinDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ObservedMaxDisplay, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- MODE E: ANALOG GAUGE CLUSTER VIEW -->
                                <StackPanel Padding="14" Visibility="{x:Bind ViewModel.AnalogGaugeModeVisibility, Mode=OneWay}">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SnaplistPids, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LivePidRowViewModel">
                                                <Border Width="260" Margin="6" Padding="12" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource AppRowAltBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1.5">
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <!-- Analog Dial Canvas -->
                                                        <Canvas Width="180" Height="106">
                                                            <Ellipse Width="156" Height="156" Canvas.Left="12" Canvas.Top="14" Stroke="{ThemeResource AppSubtleBorderBrush}" StrokeThickness="8" />
                                                            <!-- Needle from dial pivot (90, 92) to dynamic (GaugeNeedleX, GaugeNeedleY) -->
                                                            <Line X1="90" Y1="92"
                                                                  X2="{x:Bind GaugeNeedleX, Mode=OneWay}"
                                                                  Y2="{x:Bind GaugeNeedleY, Mode=OneWay}"
                                                                  Stroke="{ThemeResource DtcActiveBrush}"
                                                                  StrokeThickness="3.5" />
                                                            <Ellipse Width="12" Height="12" Canvas.Left="84" Canvas.Top="86" Fill="{ThemeResource AppAccentBrush}" />
                                                        </Canvas>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                            <TextBlock Text="{x:Bind DisplayValue, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="20" FontWeight="Bold" />
                                                            <TextBlock Text="{x:Bind DisplayUnit, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <Border Background="{ThemeResource SimBadgeBackgroundBrush}" BorderBrush="{ThemeResource SimBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Center" Visibility="{x:Bind SimulatedBadgeVisibility, Mode=OneWay}">
                                                            <TextBlock Text="SIMULATED" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- MODE F: LINE GRAPH WITH DUAL CURSORS & DELTA READOUT (Screenshot 16) -->
                                <StackPanel Padding="14" Spacing="12" Visibility="{x:Bind ViewModel.LineGraphModeVisibility, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="Graph Parameter:" FontWeight="Bold" VerticalAlignment="Center" />
                                            <ComboBox MinWidth="240"
                                                      MinHeight="44"
                                                      ItemsSource="{x:Bind ViewModel.LivePids, Mode=OneWay}"
                                                      SelectedItem="{x:Bind ViewModel.SelectedGraphPid, Mode=TwoWay}"
                                                      DisplayMemberPath="Name" />
                                        </StackPanel>

                                        <!-- Cursor Delta Header (Matches top of Screenshot 16) -->
                                        <Border Grid.Column="2" Background="{ThemeResource AppRowAltBrush}" BorderBrush="{ThemeResource AppFocusBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource AppCornerRadius}" Padding="12,6">
                                            <TextBlock Text="{x:Bind ViewModel.CursorDeltaLabel, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="13" />
                                        </Border>
                                    </Grid>

                                    <!-- Graph Plot Surface with Vertical Scale + Dual Cursors -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="720" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Vertical Y-Axis Labels -->
                                        <Grid Grid.Column="0" Height="220" Padding="0,4,10,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.GraphScaleTopLabel, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.GraphScaleMidLabel, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                            <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.GraphScaleBottomLabel, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12" FontWeight="SemiBold" />
                                        </Grid>

                                        <!-- Plot Canvas (720 x 220) -->
                                        <Border Grid.Column="1" Width="720" Height="220" Background="{ThemeResource AppBackgroundBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Canvas Width="720" Height="220">
                                                <!-- Grid lines -->
                                                <Line X1="0" Y1="55" X2="720" Y2="55" Stroke="{ThemeResource AppSubtleBorderBrush}" StrokeThickness="1" />
                                                <Line X1="0" Y1="110" X2="720" Y2="110" Stroke="{ThemeResource AppSubtleBorderBrush}" StrokeThickness="1" />
                                                <Line X1="0" Y1="165" X2="720" Y2="165" Stroke="{ThemeResource AppSubtleBorderBrush}" StrokeThickness="1" />

                                                <!-- Live Waveform Polyline -->
                                                <Polyline Points="{Binding GraphPoints}"
                                                          Stroke="{ThemeResource AppAccentBrush}"
                                                          StrokeThickness="2.5" />

                                                <!-- Cursor A Vertical Marker -->
                                                <Line X1="{x:Bind ViewModel.CursorAX, Mode=OneWay}" Y1="0"
                                                      X2="{x:Bind ViewModel.CursorAX, Mode=OneWay}" Y2="220"
                                                      Stroke="{ThemeResource DtcActiveBrush}"
                                                      StrokeThickness="2" />

                                                <!-- Cursor B Vertical Marker -->
                                                <Line X1="{x:Bind ViewModel.CursorBX, Mode=OneWay}" Y1="0"
                                                      X2="{x:Bind ViewModel.CursorBX, Mode=OneWay}" Y2="220"
                                                      Stroke="{ThemeResource AppSuccessBrush}"
                                                      StrokeThickness="2" />
                                            </Canvas>
                                        </Border>
                                    </Grid>

                                    <!-- Touch-friendly Sliders for Cursor A and Cursor B (Screenshot 16) -->
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.CursorALabel, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource DtcActiveBrush}" />
                                            <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.CursorAPercent, Mode=TwoWay}" Header="Cursor A Position (%)" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{x:Bind ViewModel.CursorBLabel, Mode=OneWay}" FontWeight="Bold" Foreground="{ThemeResource AppSuccessBrush}" />
                                            <Slider Minimum="0" Maximum="100" Value="{x:Bind ViewModel.CursorBPercent, Mode=TwoWay}" Header="Cursor B Position (%)" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- MODE G: BUILD A CUSTOM DISPLAY (6 Slots — Screenshot 15) -->
                                <StackPanel Padding="14" Spacing="14" Visibility="{x:Bind ViewModel.CustomDisplayModeVisibility, Mode=OneWay}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Build a Custom Display (6 Configurable Slots — Screenshot 15)" FontSize="16" FontWeight="Bold" />
                                            <TextBlock Text="Assign any live parameter and choose Bar Graph, Gauge, Analog Meter, or Digital Meter per slot." FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                    Command="{x:Bind ViewModel.ApplyCustomDisplaySlotsCommand}"
                                                    Content="Apply Slots" />
                                            <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                    Command="{x:Bind ViewModel.ClearCustomDisplaySlotsCommand}"
                                                    Content="Clear All" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 6-Slot Builder Grid (Wired via x:Bind to CustomDisplaySlots) -->
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CustomDisplaySlots, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CustomDisplaySlotViewModel">
                                                <Border Width="330" Margin="6" Padding="12" CornerRadius="{StaticResource CardCornerRadius}" Background="{ThemeResource AppRowAltBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1.5">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="{x:Bind SlotHeader}" FontWeight="Bold" Foreground="{ThemeResource AppAccentBrush}" />

                                                        <!-- Parameter + Display Type Pickers (Screenshot 15) -->
                                                        <ComboBox HorizontalAlignment="Stretch"
                                                                  MinHeight="44"
                                                                  Header="Parameter"
                                                                  ItemsSource="{x:Bind AvailablePidNames, Mode=OneWay}"
                                                                  SelectedItem="{x:Bind SelectedPidName, Mode=TwoWay}" />

                                                        <ComboBox HorizontalAlignment="Stretch"
                                                                  MinHeight="44"
                                                                  Header="Display Type"
                                                                  ItemsSource="{x:Bind DisplayTypes}"
                                                                  SelectedItem="{x:Bind DisplayType, Mode=TwoWay}" />

                                                        <!-- Live Rendered Slot Preview -->
                                                        <Border Padding="10" CornerRadius="6" Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1" MinHeight="96">
                                                            <Grid>
                                                                <TextBlock Text="Slot Empty — Select Parameter &amp; Click Apply"
                                                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                           FontSize="12"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{x:Bind EmptySlotVisibility, Mode=OneWay}" />

                                                                <StackPanel Spacing="6" Visibility="{x:Bind BoundPidVisibility, Mode=OneWay}">
                                                                    <TextBlock Text="{x:Bind BoundPidName, Mode=OneWay}" FontWeight="Bold" FontSize="13" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="{x:Bind BoundPidDisplayValue, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AppAccentBrush}" />
                                                                        <TextBlock Text="{x:Bind BoundPidDisplayUnit, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                                                    </StackPanel>
                                                                    <ProgressBar Minimum="0" Maximum="100"
                                                                                 Value="{x:Bind BoundPidNormalizedPercent, Mode=OneWay}"
                                                                                 Height="14"
                                                                                 Visibility="{x:Bind BarGraphVisibility, Mode=OneWay}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <!-- ======================================================= -->
                        <!-- SECTION 3: FREEZE FRAME SNAPSHOT (Screenshots 04 & 07)   -->
                        <!-- ======================================================= -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Visibility="{x:Bind ViewModel.FreezeFrameSectionVisibility, Mode=OneWay}">
                            <StackPanel>
                                <Grid Background="{ThemeResource AppToolbarBrush}" Padding="12,10" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Freeze Frame Snapshot" FontWeight="Bold" />
                                        <TextBlock Text="{x:Bind ViewModel.FreezeFrameTimestamp, Mode=OneWay}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Value" FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Units" FontWeight="Bold" Margin="16,0,0,0" />
                                    <TextBlock Grid.Column="3" Text="Provenance" FontWeight="Bold" />
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.FreezeFramePids, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LivePidRowViewModel">
                                            <Grid Padding="12,8" MinHeight="44" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="130" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayValue, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind DisplayUnit, Mode=OneWay}" Margin="16,0,0,0" VerticalAlignment="Center" />
                                                <Border Grid.Column="3" Background="{ThemeResource SimBadgeBackgroundBrush}" BorderBrush="{ThemeResource SimBadgeBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{x:Bind SimulatedBadgeVisibility, Mode=OneWay}">
                                                    <TextBlock Text="SIMULATED" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================= -->
                        <!-- SECTION 4: READINESS & ON-BOARD MONITORS (04, 08, 09)    -->
                        <!-- ======================================================= -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Visibility="{x:Bind ViewModel.ReadinessSectionVisibility, Mode=OneWay}">
                            <StackPanel>
                                <Grid Background="{ThemeResource AppToolbarBrush}" Padding="12,10" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="210" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ECU ID" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="Monitor Group" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Text="Readiness / System Monitor" FontWeight="Bold" />
                                    <TextBlock Grid.Column="3" Text="Source" FontWeight="Bold" />
                                    <TextBlock Grid.Column="4" Text="Status" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.ReadinessMonitors, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReadinessMonitorRowViewModel">
                                            <Grid Padding="12,8" MinHeight="44" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="180" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind EcuId}" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind MonitorGroup}" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind MonitorName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind ProvenanceBadgeText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind StatusText}" Foreground="{x:Bind StatusBrush}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================= -->
                        <!-- SECTION 5: DIAGNOSTIC LOG / AUDIT NOTES                  -->
                        <!-- ======================================================= -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                            <StackPanel>
                                <Grid Background="{ThemeResource AppToolbarBrush}" Padding="12,10" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Diagnostic Log / Audit Notes" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="Audit trail for adapter connections, recordings, and DTC clears" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </Grid>

                                <TextBlock Text="No diagnostic log entries yet."
                                           Padding="14,16"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.NoDiagnosticLogVisibility, Mode=OneWay}" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.DiagnosticLog, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DiagnosticLogEntry">
                                            <Grid Padding="12,8" MinHeight="44" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Timestamp}" Foreground="{ThemeResource AppTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 3B. MINIMAL EQUIPMENT / ASSET LIST (Wired to DataServices.Assets) -->
                <Grid Grid.Row="2"
                      Padding="14,12"
                      Visibility="{x:Bind ViewModel.AssetsViewVisibility, Mode=OneWay}">
                    <Border Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="16">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Equipment &amp; Vehicle Asset Registry (SQLite Repository)" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="Reads from GseTechPro.Data.DataServices.Assets" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.ReloadDatabaseRecordsCommand}"
                                        Content="Refresh Repository" />
                            </Grid>

                            <Border Background="{ThemeResource AppRowAltBrush}"
                                    BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource AppCornerRadius}"
                                    Padding="16"
                                    Visibility="{x:Bind ViewModel.NoAssetsVisibility, Mode=OneWay}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="No equipment or vehicle assets registered yet." FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="The local SQLite database is initialized and seeded with the shop record. Assets added in the Equipment Registry will appear here."
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <ListView ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Asset">
                                        <Grid Padding="12,10" MinHeight="48">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind AssetNumber}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind AssetKind}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Status}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- =============================================================== -->
                <!-- 3C. PHASE 5: WORK ORDER / REPAIR ORDER BROWSER (Screenshot 03)  -->
                <!-- WO number assignment (AssignNextNumberAsync), preview pane with -->
                <!-- labeled rows, outcome entry on close, and comeback confirmation -->
                <!-- =============================================================== -->
                <ScrollViewer Grid.Row="2"
                              Padding="14,12"
                              Visibility="{x:Bind ViewModel.WorkOrdersViewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <!-- Top Action Bar -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Work Orders" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveWorkOrderSummaryText, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.WorkOrderCloseStatusMessage, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Command="{x:Bind ViewModel.CreateActiveWorkOrderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE710;" FontSize="15" />
                                            <TextBlock Text="Create Numbered WO" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Tag="Recommendations"
                                            Click="OnNavRailButtonClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE9CE;" FontSize="15" />
                                            <TextBlock Text="Repair Recommendations" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Command="{x:Bind ViewModel.ReloadDatabaseRecordsCommand}"
                                            Content="Refresh Work Orders" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- RO List Pane (Matches Screenshot 03 top list with RO Number column) -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                            <StackPanel>
                                <Grid Background="{ThemeResource AppToolbarBrush}" Padding="12,10" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="165" />
                                        <ColumnDefinition Width="175" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RO Number" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="Vehicle / Asset" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" />
                                    <TextBlock Grid.Column="3" Text="Complaint / Symptoms Summary" FontWeight="Bold" />
                                    <TextBlock Grid.Column="4" Text="Outcome" FontWeight="Bold" />
                                    <TextBlock Grid.Column="5" Text="Opened At" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>

                                <Border Background="{ThemeResource AppRowAltBrush}"
                                        Padding="16"
                                        Visibility="{x:Bind ViewModel.NoWorkOrdersVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="No saved Work Orders in the local database yet." FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" />
                                        <TextBlock Text="Tap 'Create Numbered WO' above to assign the next zero-padded six-digit work-order number (000001) and open a new repair order."
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <ListView ItemsSource="{x:Bind ViewModel.WorkOrderBrowserRows, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.SelectedWorkOrderBrowserRow, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          MaxHeight="260">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkOrderBrowserRowViewModel">
                                            <Grid Padding="12,10" MinHeight="48">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="135" />
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="165" />
                                                    <ColumnDefinition Width="175" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind DisplayNumber}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" Foreground="{ThemeResource AppAccentBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind AssetDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind StatusDisplay}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind ComplaintDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind OutcomeDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{x:Bind OpenedAt}" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- WORK ORDER DOCUMENT (Shop Foreman Pro: RO Viewer + Integrated Diagnostics tabs) -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                            <StackPanel>
                                <SelectorBar x:Name="WorkOrderDocumentTabs"
                                             Padding="8,2"
                                             SelectionChanged="OnWorkOrderDocumentTabChanged"
                                             AutomationProperties.Name="Work order views">
                                    <SelectorBarItem Text="RO Viewer" Tag="0" IsSelected="True" MinHeight="44">
                                        <SelectorBarItem.Icon>
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8A5;" />
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                    <SelectorBarItem Text="Integrated Diagnostics" Tag="1" MinHeight="44">
                                        <SelectorBarItem.Icon>
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE9D9;" />
                                        </SelectorBarItem.Icon>
                                    </SelectorBarItem>
                                </SelectorBar>

                                <!-- RO VIEWER: navy section tile on the left, label/value rows on the right -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.RoSections, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.RoViewerVisibility, Mode=OneWay}"
                                              BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                              BorderThickness="0,1,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RoSection">
                                            <Grid BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="168" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{ThemeResource SectionTileBrush}" Padding="10,12" MinHeight="48">
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="{x:Bind Glyph}" FontSize="24"
                                                                  Foreground="{ThemeResource SectionTileTextBrush}" />
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                                                                   Foreground="{ThemeResource SectionTileTextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RoFieldRow">
                                                            <Grid MinHeight="34" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="200" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{x:Bind Label}" FontWeight="Bold" Padding="10,7"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind Value}" Padding="10,7" TextWrapping="Wrap"
                                                                           VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- INTEGRATED DIAGNOSTICS: record grid, preview, record note -->
                                <Grid Visibility="{x:Bind ViewModel.IntegratedDiagnosticsVisibility, Mode=OneWay}"
                                      BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                      BorderThickness="0,1,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Background="{ThemeResource AppToolbarBrush}" Padding="12,8"
                                          BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE73E;" FontSize="14"
                                                  Foreground="{ThemeResource AppSuccessBrush}" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="Record Type" FontWeight="Bold" />
                                        <TextBlock Grid.Column="2" Text="Origin" FontWeight="Bold" />
                                        <TextBlock Grid.Column="3" Text="Date / Time" FontWeight="Bold" />
                                        <TextBlock Grid.Column="4" Text="Technician" FontWeight="Bold" />
                                        <TextBlock Grid.Column="5" Text="Record Note" FontWeight="Bold" />
                                    </Grid>

                                    <Border Grid.Row="1" Background="{ThemeResource AppRowAltBrush}" Padding="16"
                                            Visibility="{x:Bind ViewModel.NoDiagnosticRecordsVisibility, Mode=OneWay}">
                                        <TextBlock Text="No diagnostic records on this work order yet. Readings, scope waveforms, repairs and the close-out outcome appear here as they are saved."
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                    </Border>

                                    <ListView Grid.Row="2"
                                              ItemsSource="{x:Bind ViewModel.DiagnosticRecords, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedDiagnosticRecord, Mode=TwoWay}"
                                              SelectionMode="Single"
                                              AutomationProperties.Name="Diagnostic records"
                                              MaxHeight="300">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DiagnosticRecordRow">
                                                <Grid MinHeight="44" Padding="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="170" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="{x:Bind Glyph}" FontSize="16"
                                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind RecordType}" FontWeight="SemiBold" />
                                                        <Border Background="{ThemeResource SimBadgeBackgroundBrush}" BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                                BorderThickness="1" CornerRadius="{StaticResource BadgeCornerRadius}" Padding="4,0"
                                                                Visibility="{x:Bind SimulatedBadgeVisibility}">
                                                            <TextBlock Text="SIM" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind Origin}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{x:Bind DateTime}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" Text="{x:Bind Technician}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="5" Text="{x:Bind Note}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>

                                    <!-- Preview + Record Note (bottom of SFP's Integrated Diagnostics) -->
                                    <Grid Grid.Row="3" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="168" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{ThemeResource SectionTileBrush}" Padding="10,12" MinHeight="96">
                                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE70B;" FontSize="24"
                                                          Foreground="{ThemeResource SectionTileTextBrush}" />
                                                <TextBlock Text="Record Note" FontWeight="Bold" TextAlignment="Center"
                                                           Foreground="{ThemeResource SectionTileTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Padding="12,10" Spacing="4">
                                            <TextBlock Text="Preview" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.DiagnosticRecordPreviewText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Padding="12,10" Spacing="4"
                                                    BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="1,0,0,0">
                                            <TextBlock Text="Note" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.DiagnosticRecordNoteText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Outcome Entry & Close Work Order Card (ADR-010 §4 / §6) -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Close Active Work Order — Record Outcome &amp; Detect Comebacks (ADR-010)"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="Bold" />
                                <TextBlock Text="Closing a work order records an outcome (Fixed / NotFixed / Unsure), assigns a 6-digit WO number if missing, and checks for repeat failures (comebacks) within the configured day/hour window."
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource MinTouchSize}"
                                              Header="Repair Outcome (Required)"
                                              ItemsSource="{x:Bind ViewModel.AllOutcomeResults}"
                                              SelectedItem="{x:Bind ViewModel.SelectedCloseOutcomeResult, Mode=TwoWay}" />

                                    <TextBox Grid.Column="1"
                                             MinHeight="{StaticResource MinTouchSize}"
                                             Header="Outcome Reason / Verification Notes (Optional)"
                                             PlaceholderText="e.g. Main relief valve replaced, tested at 2,400 psi under load"
                                             Text="{x:Bind ViewModel.CloseOutcomeReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource ActionTouchButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            Command="{x:Bind ViewModel.CloseActiveWorkOrderFromPanelCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE73E;" FontSize="16" />
                                            <TextBlock Text="Close Work Order &amp; Save Outcome" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- =============================================================== -->
                <!-- 3D. PHASE 3: AI TECH CHAT SCREEN (ADR-008)                      -->
                <!-- Chat messages, mandatory "AI suggestion" badge, tappable         -->
                <!-- citations (manual-page / work-order / dtc), degraded banners     -->
                <!-- =============================================================== -->
                <Grid Grid.Row="2"
                      Padding="14,12"
                      RowSpacing="10"
                      Visibility="{x:Bind ViewModel.TechChatViewVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <!-- Row 0: AI Service Health & Model Config Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Degraded / Warming-Up Warning Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Citation Action Feedback Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Scrollable Chat Message List -->
                        <RowDefinition Height="*" />
                        <!-- Row 4: Quick-Prompt Touch Chips + Docked Input Bar (OSK-safe) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- AI Service Status & Configured Model Bar (Never hardcoded model names) -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12,8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <!-- Ready Badge -->
                                <Border Background="{ThemeResource RealBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource RealBadgeBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource BadgeCornerRadius}"
                                        Padding="10,4"
                                        Visibility="{x:Bind ViewModel.AiReadyBadgeVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource RealBadgeTextBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.AiStatusIndicatorText, Mode=OneWay}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource RealBadgeTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Warming Up / Degraded Search Badge -->
                                <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource BadgeCornerRadius}"
                                        Padding="10,4"
                                        Visibility="{x:Bind ViewModel.AiDegradedBadgeVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.AiStatusIndicatorText, Mode=OneWay}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Unavailable Badge -->
                                <Border Background="{ThemeResource SafetyWarningBannerBackgroundBrush}"
                                        BorderBrush="{ThemeResource SafetyWarningBannerBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource BadgeCornerRadius}"
                                        Padding="10,4"
                                        Visibility="{x:Bind ViewModel.AiUnavailableBadgeVisibility, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                        <TextBlock Text="{x:Bind ViewModel.AiStatusIndicatorText, Mode=OneWay}" FontWeight="Bold" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.AiModelSummaryText, Mode=OneWay}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Safety Rule: AI output is a suggestion — the technician makes the final call. Never skip manufacturer safety warnings."
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.RefreshAiStatusCommand}"
                                        ToolTipService.ToolTip="Poll /health and /config on the local AI service">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE72C;" FontSize="14" />
                                        <TextBlock Text="Check AI Status" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Degraded / Warming-Up State Banner (Shown when the local model (llama.cpp) or AI service is unavailable/starting) -->
                    <Border Grid.Row="1"
                            Background="{ThemeResource SimBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                            BorderThickness="1.5"
                            CornerRadius="{StaticResource AppCornerRadius}"
                            Padding="12,8"
                            Visibility="{x:Bind ViewModel.AiChatOfflineBannerVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource SimBadgeTextBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.AiStatusBannerText, Mode=OneWay}"
                                           FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{ThemeResource SimBadgeTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="You can still search repair manuals (BM25 fallback), inspect guided troubleshooting steps, and run vehicle diagnostics."
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource SimBadgeTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Citation Tap Feedback Banner -->
                    <Border Grid.Row="2"
                            Background="{ThemeResource AiSuggestionBadgeBackgroundBrush}"
                            BorderBrush="{ThemeResource AiSuggestionBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AppCornerRadius}"
                            Padding="12,8"
                            Visibility="{x:Bind ViewModel.CitationActionBannerVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE82D;" FontSize="15" Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.CitationActionBanner, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AiSuggestionBadgeTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Chat Message History List -->
                    <Border Grid.Row="3"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ChatMessages, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                        <Border Margin="0,0,0,10"
                                                Padding="14,10"
                                                MaxWidth="820"
                                                HorizontalAlignment="{x:Bind CardHorizontalAlignment}"
                                                Background="{ThemeResource AppRowAltBrush}"
                                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CardCornerRadius}">
                                            <StackPanel Spacing="8">
                                                <!-- Message Header: Role + Timestamp + Mandatory AI Suggestion Badge -->
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="{x:Bind RoleGlyph}" FontSize="14" />
                                                        <TextBlock Text="{x:Bind RoleLabel}" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />
                                                        <TextBlock Text="{x:Bind Timestamp}" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Route badge (ADR-013): where this answer came from. CLOUD is marked in amber. -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BadgeCornerRadius}"
                                                            Padding="8,3"
                                                            ToolTipService.ToolTip="{x:Bind RouteBadgeToolTip}"
                                                            Visibility="{x:Bind RouteBadgeVisibility}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE70A;" FontSize="12" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                            <TextBlock Text="{x:Bind RouteBadgeText}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BadgeCornerRadius}"
                                                            Padding="8,3"
                                                            ToolTipService.ToolTip="{x:Bind RouteBadgeToolTip}"
                                                            Visibility="{x:Bind CloudRouteBadgeVisibility}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE753;" FontSize="12" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                            <TextBlock Text="{x:Bind RouteBadgeText}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Mandatory "AI SUGGESTION" Label whenever IsSuggestion == true -->
                                                    <Border Background="{ThemeResource AiSuggestionBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource AiSuggestionBadgeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BadgeCornerRadius}"
                                                            Padding="8,3"
                                                            Visibility="{x:Bind SuggestionBadgeVisibility}">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                                            <TextBlock Text="{x:Bind SuggestionBadgeText}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Degraded Notice Indicator (when /chat returned 503 ai_unavailable or ai_starting) -->
                                                <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                        BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource BadgeCornerRadius}"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{x:Bind DegradedNoticeVisibility}">
                                                    <TextBlock Text="DEGRADED / OFFLINE STATUS NOTICE"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                </Border>

                                                <!-- Message Text -->
                                                <TextBlock Text="{x:Bind Content}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           TextWrapping="Wrap"
                                                           IsTextSelectionEnabled="True" />

                                                <!-- Tappable Citations (manual-page -> Manual Viewer or "Manual, page N"; work-order -> WO tab) -->
                                                <StackPanel Spacing="6" Visibility="{x:Bind CitationsVisibility}">
                                                    <TextBlock Text="Cited Sources (Tap to open manual page or work order):"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                    <ItemsControl ItemsSource="{x:Bind Citations}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <ItemsWrapGrid Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CitationItemViewModel">
                                                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                                        Margin="0,0,8,6"
                                                                        Click="OnCitationButtonClick"
                                                                        ToolTipService.ToolTip="{x:Bind Label}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="{x:Bind Glyph}" FontSize="14" />
                                                                        <Border Background="{ThemeResource AiSuggestionBadgeBackgroundBrush}"
                                                                                BorderBrush="{ThemeResource AiSuggestionBadgeBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                                                                Padding="6,1"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind KindBadge}"
                                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                                                        </Border>
                                                                        <TextBlock Text="{x:Bind Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Quick-Prompt Glove Buttons + Docked Input Box (44x44+ touch targets, OSK-friendly) -->
                    <Border Grid.Row="4"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="12,10">
                        <StackPanel Spacing="8">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Tag="Why is hydraulic lift slow and what is the test port pressure spec?"
                                            Click="OnQuickPromptButtonClick"
                                            Content="Hydraulic Pressure Spec" />
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Tag="Explain the active DTCs and recommended diagnostic checks."
                                            Click="OnQuickPromptButtonClick"
                                            Content="Explain Active DTCs" />
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Tag="What past work orders fixed a no-crank / starter circuit fault?"
                                            Click="OnQuickPromptButtonClick"
                                            Content="Similar Past Repairs" />
                                    <CheckBox MinHeight="{StaticResource MinTouchSize}"
                                              Margin="8,0,0,0"
                                              IsChecked="{x:Bind ViewModel.UseChatTools, Mode=TwoWay}"
                                              Content="Use RAG &amp; History Tools" />
                                    <ToggleSwitch MinHeight="{StaticResource MinTouchSize}"
                                                  Margin="8,0,0,0"
                                                  OnContent="This tablet only (this job)"
                                                  OffContent="This tablet only (this job)"
                                                  IsOn="{x:Bind ViewModel.IsJobTabletOnly, Mode=TwoWay}"
                                                  ToolTipService.ToolTip="Keep this job's AI questions on this tablet, whatever the shop route setting" />
                                    <TextBlock VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               Text="{x:Bind ViewModel.ChatRouteSummaryText, Mode=OneWay}" />
                                </StackPanel>
                            </ScrollViewer>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         MinHeight="{StaticResource MinTouchSize}"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="Ask the local AI technician assistant (e.g. hydraulic pressure port G3, SPN 94 FMI 3, or past repairs)…"
                                         Text="{x:Bind ViewModel.ChatInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnChatInputKeyDown" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionTouchButtonStyle}"
                                        MinWidth="110"
                                        Command="{x:Bind ViewModel.SendChatMessageCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE724;" FontSize="15" />
                                        <TextBlock Text="Send" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.ClearChatHistoryCommand}"
                                        Content="Clear Chat" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- =============================================================== -->
                <!-- 3E. PHASE 4: GUIDED TROUBLESHOOTING DECISION-TREE WALKER        -->
                <!-- Calls StartGuidedAsync / NextGuidedAsync, converts canonical    -->
                <!-- SpecMin/SpecMax to display units, persists Reading before next, -->
                <!-- and surfaces safety warnings FIRST + terminal suggestion badge   -->
                <!-- =============================================================== -->
                <ScrollViewer Grid.Row="2"
                              Padding="14,12"
                              Visibility="{x:Bind ViewModel.GuidedViewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <!-- Header & Quick Mode Switcher -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Guided Troubleshooting Decision Trees (/guided/start &amp; /guided/next)" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.GuidedStatusMessage, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveWorkOrderSummaryText, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Command="{x:Bind ViewModel.CreateActiveWorkOrderCommand}"
                                            Content="Open / Create WO" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Guided Session Selector Card -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="1. Select Equipment Model &amp; Symptom / Complaint" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />

                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource MinTouchSize}"
                                              Header="Equipment / Vehicle Model"
                                              ItemsSource="{x:Bind ViewModel.GuidedEquipmentModels, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedGuidedEquipmentModel, Mode=TwoWay}" />

                                    <ComboBox Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource MinTouchSize}"
                                              Header="Structured Symptom (Optional)"
                                              ItemsSource="{x:Bind ViewModel.GuidedSymptoms, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedGuidedSymptom, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             MinHeight="{StaticResource MinTouchSize}"
                                             Header="Technician Complaint / Observed Symptom Text (Optional)"
                                             PlaceholderText="e.g. Hydraulic boom will not lift under load; engine will not crank"
                                             Text="{x:Bind ViewModel.GuidedComplaintText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <Button Grid.Column="1"
                                            Style="{StaticResource ActionTouchButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            Command="{x:Bind ViewModel.StartGuidedTroubleshootingCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE890;" FontSize="16" />
                                            <TextBlock Text="Start Guided Session" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Rendered GuidedStep Card -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="16"
                                Visibility="{x:Bind ViewModel.HasGuidedStepVisibility, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{x:Bind ViewModel.GuidedStepHeaderText, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />

                                    <!-- ADR-009 §3: Prominent "DRAFT — not yet approved" badge when active tree has status='draft' -->
                                    <Border Grid.Column="1"
                                            MinHeight="{StaticResource MinTouchSize}"
                                            Background="{ThemeResource SimBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="{StaticResource AppCornerRadius}"
                                            Padding="12,8"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.GuidedDraftTreeBadgeVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}"
                                                      Glyph="&#xE7BA;"
                                                      FontSize="16"
                                                      Foreground="{ThemeResource SimBadgeTextBrush}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.GuidedDraftTreeBadgeText, Mode=OneWay}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource SimBadgeTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Safety Warnings Displayed FIRST Before Step Instructions (AGENTS.md Rule 6 & §4.5 #2) -->
                                <Border Background="{ThemeResource SafetyWarningBannerBackgroundBrush}"
                                        BorderBrush="{ThemeResource SafetyWarningBannerBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource AppCornerRadius}"
                                        Padding="12,10"
                                        Visibility="{x:Bind ViewModel.GuidedSafetyWarningsVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                            <TextBlock Text="MANDATORY SAFETY WARNINGS — READ BEFORE PROCEEDING"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.GuidedSafetyWarnings, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}"
                                                               Margin="0,2,0,0"
                                                               FontWeight="SemiBold"
                                                               Foreground="{ThemeResource SafetyWarningBannerTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Available == false State -->
                                <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                        BorderThickness="1.5"
                                        CornerRadius="{StaticResource AppCornerRadius}"
                                        Padding="14,12"
                                        Visibility="{x:Bind ViewModel.GuidedTreeUnavailableVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                            <TextBlock Text="No Matching Troubleshooting Tree Available"
                                                       FontWeight="Bold"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       Foreground="{ThemeResource SimBadgeTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind ViewModel.GuidedInstructionText, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource SimBadgeTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Active Tree Step State: Available == true -->
                                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.GuidedTreeActiveStepVisibility, Mode=OneWay}">
                                    <Border Background="{ThemeResource AppRowAltBrush}"
                                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource AppCornerRadius}"
                                            Padding="14,12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{x:Bind ViewModel.GuidedInstructionText, Mode=OneWay}"
                                                       FontSize="{StaticResource FontSizeSubtitle}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.GuidedQuestionText, Mode=OneWay}"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Bind ViewModel.GuidedSpecSummaryText, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Draft / TODO Spec Notice (when SpecSource starts with TODO or no numeric spec) -->
                                    <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource AppCornerRadius}"
                                            Padding="12,8"
                                            Visibility="{x:Bind ViewModel.GuidedSpecTodoVisibility, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE946;" FontSize="15" Foreground="{ThemeResource SimBadgeTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.GuidedSpecTodoBannerText, Mode=OneWay}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource SimBadgeTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Terminal Leaf Diagnosis / Repair Suggestion -->
                                    <Border Background="{ThemeResource AiSuggestionBadgeBackgroundBrush}"
                                            BorderBrush="{ThemeResource AiSuggestionBadgeBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="{StaticResource AppCornerRadius}"
                                            Padding="14,12"
                                            Visibility="{x:Bind ViewModel.GuidedTerminalResultVisibility, Mode=OneWay}">
                                        <StackPanel Spacing="6">
                                            <Border Background="{ThemeResource AppSurfaceBrush}"
                                                    BorderBrush="{ThemeResource AiSuggestionBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource BadgeCornerRadius}"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.GuidedTerminalSuggestionLabel, Mode=OneWay}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="TERMINAL DIAGNOSIS / REPAIR SUGGESTION"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.GuidedTerminalResultText, Mode=OneWay}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{ThemeResource AiSuggestionBadgeTextBrush}"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Measurement & Verdict Controls (/guided/next) -->
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <NumberBox Grid.Column="0"
                                                   MinHeight="{StaticResource MinTouchSize}"
                                                   Header="Measured Value"
                                                   PlaceholderText="Enter reading…"
                                                   Value="{x:Bind ViewModel.GuidedReadingBoxValue, Mode=TwoWay}" />

                                        <ComboBox Grid.Column="1"
                                                  HorizontalAlignment="Stretch"
                                                  MinHeight="{StaticResource MinTouchSize}"
                                                  Header="Unit"
                                                  ItemsSource="{x:Bind ViewModel.GuidedAvailableUnits, Mode=OneWay}"
                                                  SelectedItem="{x:Bind ViewModel.GuidedReadingUnit, Mode=TwoWay}" />

                                        <TextBox Grid.Column="2"
                                                 MinHeight="{StaticResource MinTouchSize}"
                                                 Header="Observation / Answer"
                                                 PlaceholderText="Optional step observation…"
                                                 Text="{x:Bind ViewModel.GuidedAnswerText, Mode=TwoWay}" />
                                    </Grid>

                                    <TextBlock Text="{x:Bind ViewModel.GuidedReadingPreviewText, Mode=OneWay}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="Bold"
                                               Foreground="{x:Bind ViewModel.GuidedReadingPreviewBrush, Mode=OneWay}"
                                               Visibility="{x:Bind ViewModel.GuidedReadingEntryVisibility, Mode=OneWay}" />

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                Tag="auto"
                                                Click="OnGuidedVerdictButtonClick"
                                                Visibility="{x:Bind ViewModel.GuidedReadingEntryVisibility, Mode=OneWay}"
                                                Content="Record Reading &amp; Next Step" />
                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                Tag="pass"
                                                Click="OnGuidedVerdictButtonClick"
                                                Content="PASS — Next Step" />
                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                Tag="fail"
                                                Click="OnGuidedVerdictButtonClick"
                                                Content="FAIL — Next Step" />
                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                Tag="na"
                                                Click="OnGuidedVerdictButtonClick"
                                                Content="N/A — Continue" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- =============================================================== -->
                <!-- 3E-2. PHASE 4: MANUAL READINGS-ENTRY SCREEN (NO-ECU EQUIPMENT)  -->
                <!-- Test-point picker (filterable by model + free-entry), mandatory -->
                <!-- safety warnings BEFORE reading entry, canonical SI + auto       -->
                <!-- pass/fail, and saved readings table with SIMULATED badge        -->
                <!-- =============================================================== -->
                <ScrollViewer Grid.Row="2"
                              Padding="14,12"
                              Visibility="{x:Bind ViewModel.ReadingsViewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <!-- Header & Active Work Order Bar -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="14,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Manual Readings &amp; Test-Point Entry (No-ECU GSE Troubleshooting)"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.ManualReadingStatusMessage, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.ActiveWorkOrderSummaryText, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppAccentBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Command="{x:Bind ViewModel.CreateActiveWorkOrderCommand}"
                                            Content="Open / Create WO" />
                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                            Command="{x:Bind ViewModel.EnableFreeEntryReadingModeCommand}"
                                            Content="Free-Entry Mode" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Section 1: Test-Point Picker & Model Filter -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="1. Select Equipment Model Filter &amp; Test Point (or Free-Entry)"
                                           FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeBody}" />

                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource MinTouchSize}"
                                              Header="Filter by Equipment Model"
                                              ItemsSource="{x:Bind ViewModel.ReadingsModelFilters, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedReadingsModelFilter, Mode=TwoWay}" />

                                    <ComboBox Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource MinTouchSize}"
                                              Header="Test Point (or Free-Entry Reading)"
                                              ItemsSource="{x:Bind ViewModel.FilteredTestPoints, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedTestPointItem, Mode=TwoWay}" />
                                </Grid>

                                <!-- Selected Test-Point Specification & Citation Details -->
                                <Border Background="{ThemeResource AppRowAltBrush}"
                                        BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AppCornerRadius}"
                                        Padding="14,10"
                                        Visibility="{x:Bind ViewModel.SelectedTestPointDetailsVisibility, Mode=OneWay}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedTestPointNameDisplay, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeSubtitle}"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap" />

                                        <Grid ColumnSpacing="16" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="Reading Type:" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedTestPointReadingTypeDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="Expected Unit:" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                <TextBlock Text="{x:Bind ViewModel.SelectedTestPointExpectedUnitDisplay, Mode=OneWay}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Location:" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTestPointLocationDisplay, Mode=OneWay}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Published Specification Range:" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTestPointSpecDisplay, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontWeight="Bold"
                                                       Foreground="{ThemeResource AppAccentBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Citation (spec_source):" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTestPointCitationDisplay, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Procedure Reference:" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTestPointProcedureDisplay, Mode=OneWay}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: Mandatory Safety Warnings BEFORE Reading Entry (AGENTS.md Rule 6) -->
                        <Border Background="{ThemeResource SafetyWarningBannerBackgroundBrush}"
                                BorderBrush="{ThemeResource SafetyWarningBannerBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="16,12"
                                Visibility="{x:Bind ViewModel.ActiveTestPointSafetyWarningsVisibility, Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                    <TextBlock Text="2. MANDATORY SAFETY WARNINGS — READ BEFORE TAKING MEASUREMENT"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{x:Bind ViewModel.ActiveTestPointSafetyWarnings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SafetyWarningItemViewModel">
                                            <Border Margin="0,4,0,0"
                                                    Padding="10,8"
                                                    CornerRadius="{StaticResource AppCornerRadius}"
                                                    Background="{ThemeResource AppSurfaceBrush}"
                                                    BorderBrush="{ThemeResource SafetyWarningBannerBorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Background="{ThemeResource SafetyWarningBannerBackgroundBrush}"
                                                                BorderBrush="{ThemeResource SafetyWarningBannerBorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                                                Padding="6,2">
                                                            <TextBlock Text="{x:Bind CategoryBadge}"
                                                                       FontSize="{StaticResource FontSizeSmall}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Id}"
                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Text}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind SourceCitation}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Measurement Entry, Canonical SI & Auto-Computed Pass/Fail -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="3. Enter Measurement Value &amp; Unit (Canonicalized via UnitConverter)"
                                           FontWeight="Bold"
                                           FontSize="{StaticResource FontSizeBody}" />

                                <!-- Free-Entry Mode Additional Fields -->
                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.FreeEntryFieldsVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource MinTouchSize}"
                                              Header="Reading Type"
                                              ItemsSource="{x:Bind ViewModel.AllReadingTypes}"
                                              SelectedItem="{x:Bind ViewModel.ManualReadingType, Mode=TwoWay}" />

                                    <TextBox Grid.Column="1"
                                             MinHeight="{StaticResource MinTouchSize}"
                                             Header="Channel / Component Name"
                                             PlaceholderText="e.g. P1 pump discharge, battery posts, chassis ground"
                                             Text="{x:Bind ViewModel.ManualChannelComponent, Mode=TwoWay}" />

                                    <TextBox Grid.Column="2"
                                             MinHeight="{StaticResource MinTouchSize}"
                                             Header="System (Optional)"
                                             PlaceholderText="e.g. Hydraulic, Electrical"
                                             Text="{x:Bind ViewModel.ManualSystemName, Mode=TwoWay}" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <NumberBox Grid.Column="0"
                                               MinHeight="{StaticResource MinTouchSize}"
                                               Header="Measured Value"
                                               Value="{x:Bind ViewModel.ManualReadingValue, Mode=TwoWay}" />

                                    <ComboBox Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              MinHeight="{StaticResource MinTouchSize}"
                                              Header="Entered Unit"
                                              ItemsSource="{x:Bind ViewModel.ManualReadingAvailableUnits, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.ManualReadingUnit, Mode=TwoWay}" />

                                    <TextBox Grid.Column="2"
                                             MinHeight="{StaticResource MinTouchSize}"
                                             Header="Technician Notes / Test Conditions (Optional)"
                                             PlaceholderText="e.g. Oil warm, engine at idle, calibrated DVOM"
                                             Text="{x:Bind ViewModel.ManualReadingNotes, Mode=TwoWay}" />

                                    <Button Grid.Column="3"
                                            Style="{StaticResource ActionTouchButtonStyle}"
                                            VerticalAlignment="Bottom"
                                            Command="{x:Bind ViewModel.SaveManualReadingCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE74E;" FontSize="16" />
                                            <TextBlock Text="Save Reading" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Live Canonical SI & Auto-Computed Pass/Fail Preview Strip -->
                                <Border Background="{ThemeResource AppRowAltBrush}"
                                        BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AppCornerRadius}"
                                        Padding="12,8">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Canonical SI Value:" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.ManualReadingCanonicalDisplay, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontWeight="Bold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="Auto-Computed Verdict:" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind ViewModel.ManualReadingVerdictLabel, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontWeight="Bold"
                                                       Foreground="{x:Bind ViewModel.ManualReadingVerdictBrush, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Section 4: Saved Readings for Active Work Order -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}">
                            <StackPanel>
                                <Grid Background="{ThemeResource AppToolbarBrush}" Padding="12,10" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Test Point / Component" FontWeight="Bold" />
                                    <TextBlock Grid.Column="1" Text="Entered Value" FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="Canonical SI" FontWeight="Bold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="Spec &amp; Citation" FontWeight="Bold" Margin="14,0,0,0" />
                                    <TextBlock Grid.Column="4" Text="Provenance" FontWeight="Bold" />
                                    <TextBlock Grid.Column="5" Text="Verdict" FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>

                                <TextBlock Text="No readings recorded for the active work order yet."
                                           Padding="14,16"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.NoWorkOrderReadingsVisibility, Mode=OneWay}" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.WorkOrderReadings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SavedReadingRowViewModel">
                                            <Grid Padding="12,10" MinHeight="48" BorderBrush="{ThemeResource AppSubtleBorderBrush}" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="110" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind TargetName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind ReadingTypeLabel}" FontSize="11" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind EnteredValueAndUnit}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind CanonicalValueAndUnit}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="3"
                                                           Text="{x:Bind SpecSummary}"
                                                           Margin="14,0,8,0"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap" />

                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- SIMULATED Badge when Reading.IsSimulated == true (ADR-009 §4) -->
                                                    <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BadgeCornerRadius}"
                                                            Padding="8,2"
                                                            Visibility="{x:Bind SimulatedBadgeVisibility}">
                                                        <TextBlock Text="SIMULATED" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                    </Border>

                                                    <Border Background="{ThemeResource RealBadgeBackgroundBrush}"
                                                            BorderBrush="{ThemeResource RealBadgeBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="{StaticResource BadgeCornerRadius}"
                                                            Padding="8,2"
                                                            Visibility="{x:Bind ManualBadgeVisibility}">
                                                        <TextBlock Text="MANUAL" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource RealBadgeTextBrush}" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Grid.Column="5"
                                                           Text="{x:Bind PassFailLabel}"
                                                           Foreground="{x:Bind PassFailBrush}"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- =============================================================== -->
                <!-- 3F. PHASE 3: MANUAL RAG SEARCH & CITATION VIEWER (ADR-008)      -->
                <!-- Hybrid search + BM25 fallback badge + cited manual page viewer  -->
                <!-- =============================================================== -->
                <Grid Grid.Row="2"
                      Padding="14,12"
                      RowSpacing="10"
                      Visibility="{x:Bind ViewModel.ManualSearchViewVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Query Bar + Fallback Badge -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource AppSurfaceBrush}"
                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CardCornerRadius}"
                            Padding="14,10">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         MinHeight="{StaticResource MinTouchSize}"
                                         VerticalContentAlignment="Center"
                                         PlaceholderText="Search repair manuals (e.g. 'hydraulic pressure test port', 'TUG 660 relief valve', 'torque spec')…"
                                         Text="{x:Bind ViewModel.ManualSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnManualSearchKeyDown" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource ActionTouchButtonStyle}"
                                        Command="{x:Bind ViewModel.SearchManualsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE721;" FontSize="15" />
                                        <TextBlock Text="Search Manuals" FontWeight="Bold" />
                                    </StackPanel>
                                </Button>

                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <!-- BM25 Fallback Badge when SearchManualsResponse.Fallback == true -->
                                <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                        BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource BadgeCornerRadius}"
                                        Padding="8,2"
                                        Visibility="{x:Bind ViewModel.ManualSearchFallbackBadgeVisibility, Mode=OneWay}">
                                    <TextBlock Text="TEXT-ONLY SEARCH (BM25 FALLBACK — EMBEDDING MODEL OFFLINE)"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="Bold"
                                               Foreground="{ThemeResource SimBadgeTextBrush}" />
                                </Border>

                                <TextBlock Text="{x:Bind ViewModel.ManualSearchStatusText, Mode=OneWay}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Search Results List + Cited Manual Page Viewer Split -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Search Hits -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Manual Search Hits" FontWeight="Bold" FontSize="{StaticResource FontSizeBody}" />
                                    <TextBlock Text="No manual search results loaded yet."
                                               Foreground="{ThemeResource AppTextSecondaryBrush}"
                                               Visibility="{x:Bind ViewModel.NoManualSearchResultsVisibility, Mode=OneWay}" />

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.ManualSearchResults, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ManualSearchResultViewModel">
                                                <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Margin="0,0,0,8"
                                                        Click="OnSelectManualSearchResultClick">
                                                    <StackPanel Spacing="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind Citation}" FontWeight="Bold" TextWrapping="Wrap" />
                                                            <TextBlock Grid.Column="1" Text="{x:Bind ScoreLabel}" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                        </Grid>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{x:Bind PageRangeLabel}" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{ThemeResource AppAccentBrush}" />
                                                            <TextBlock Text="{x:Bind Section}" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                            <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                                    BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="{StaticResource BadgeCornerRadius}"
                                                                    Padding="6,1"
                                                                    Visibility="{x:Bind FallbackBadgeVisibility}">
                                                                <TextBlock Text="TEXT-ONLY" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="{ThemeResource SimBadgeTextBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Manual Page / Chunk Viewer -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedManualViewerHeader, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedManualViewerContent, Mode=OneWay}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- =============================================================== -->
                <!-- 3F-2. PHASE 5: REPAIR RECOMMENDATIONS PANEL (ADR-010)            -->
                <!-- Calls SearchRepairHistoryAsync (/search/repair-history), groups -->
                <!-- by MatchTier (Model / Same family / All) without re-sorting,    -->
                <!-- shows AI SUGGESTION + text-only ranking fallback badge, and     -->
                <!-- writes recommendations + repairs rows on present/accept.        -->
                <!-- =============================================================== -->
                <ScrollViewer Grid.Row="2"
                              Padding="14,12"
                              Visibility="{x:Bind ViewModel.RecommendationsViewVisibility, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <!-- Header & Search Controls Card -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="14,10">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="Repair Recommendations &amp; Similar Past Failures (/search/repair-history)"
                                                       FontSize="{StaticResource FontSizeSubtitle}"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center" />

                                            <!-- Mandatory AI SUGGESTION Label (ADR-010 §Safety #3) -->
                                            <Border Background="{ThemeResource AiSuggestionBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource AiSuggestionBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource BadgeCornerRadius}"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                                    <TextBlock Text="{x:Bind ViewModel.RecommendationSuggestionBadgeText, Mode=OneWay}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               FontWeight="Bold"
                                                               Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Fallback Badge when Fallback == true -->
                                            <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                                    BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource BadgeCornerRadius}"
                                                    Padding="8,3"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind ViewModel.RecommendationFallbackBadgeVisibility, Mode=OneWay}">
                                                <TextBlock Text="{x:Bind ViewModel.RecommendationFallbackBadgeText, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           FontWeight="Bold"
                                                           Foreground="{ThemeResource SimBadgeTextBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind ViewModel.RecommendationStatusMessage, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="{x:Bind ViewModel.ActiveWorkOrderSummaryText, Mode=OneWay}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppAccentBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                Command="{x:Bind ViewModel.CreateActiveWorkOrderCommand}"
                                                Content="Open / Create WO" />
                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                Tag="WorkOrders"
                                                Click="OnNavRailButtonClick"
                                                Content="Work Orders &amp; Close" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             MinHeight="{StaticResource MinTouchSize}"
                                             VerticalContentAlignment="Center"
                                             PlaceholderText="Optional additional query text (e.g. 'hydraulic lift slow under load, relief valve port G3')…"
                                             Text="{x:Bind ViewModel.RecommendationQueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             KeyDown="OnRecommendationQueryKeyDown" />

                                    <Button Grid.Column="1"
                                            Style="{StaticResource ActionTouchButtonStyle}"
                                            Command="{x:Bind ViewModel.LoadRepairRecommendationsCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE721;" FontSize="15" />
                                            <TextBlock Text="Find Similar Past Repairs" FontWeight="Bold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Empty State Card ("No similar past repairs found") -->
                        <Border Background="{ThemeResource AppSurfaceBrush}"
                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="20"
                                Visibility="{x:Bind ViewModel.NoRecommendationsVisibility, Mode=OneWay}">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE946;" FontSize="18" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                    <TextBlock Text="No similar past repairs found"
                                               FontSize="{StaticResource FontSizeSubtitle}"
                                               FontWeight="Bold" />
                                </StackPanel>
                                <TextBlock Text="As closed work orders accumulate confirmed outcomes in SQLite, matching repairs on the same equipment model, same family, or fleet will appear here ranked by Wilson-smoothed success rate."
                                           Foreground="{ThemeResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Grouped Candidates by MatchTier (Model -> Family -> All, never re-sorted) -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.RecommendationTierGroups, Mode=OneWay}"
                                      Visibility="{x:Bind ViewModel.HasRecommendationsVisibility, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecommendationTierGroupViewModel">
                                    <Border Margin="0,0,0,12"
                                            Background="{ThemeResource AppSurfaceBrush}"
                                            BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CardCornerRadius}">
                                        <StackPanel>
                                            <!-- Group Header -->
                                            <Border Background="{ThemeResource AppToolbarBrush}"
                                                    BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="14,10">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind HeaderTitle}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" />
                                                    <TextBlock Text="{x:Bind HeaderSubtitle}" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Candidates in Returned Order -->
                                            <ItemsControl ItemsSource="{x:Bind Candidates}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RepairCandidateItemViewModel">
                                                        <Border Padding="14,12"
                                                                BorderBrush="{ThemeResource AppSubtleBorderBrush}"
                                                                BorderThickness="0,0,0,1">
                                                            <Grid ColumnSpacing="14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Rank & Smoothed Success Rate Badge -->
                                                                <Border Grid.Column="0"
                                                                        MinWidth="96"
                                                                        Padding="10,8"
                                                                        CornerRadius="{StaticResource AppCornerRadius}"
                                                                        Background="{ThemeResource AppRowAltBrush}"
                                                                        BorderBrush="{ThemeResource AppFocusBorderBrush}"
                                                                        BorderThickness="1"
                                                                        VerticalAlignment="Top">
                                                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                                                        <TextBlock Text="{x:Bind RankBadgeText}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="{x:Bind SuccessRateDisplay}" FontFamily="{StaticResource MonoFontFamily}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource AppAccentBrush}" HorizontalAlignment="Center" />
                                                                        <TextBlock Text="Success Rate" FontSize="10" Foreground="{ThemeResource AppTextSecondaryBrush}" HorizontalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Candidate Description, System, Evidence & Metadata -->
                                                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{x:Bind RepairDescription}"
                                                                                   FontSize="{StaticResource FontSizeSubtitle}"
                                                                                   FontWeight="Bold"
                                                                                   TextWrapping="Wrap" />

                                                                        <Border Background="{ThemeResource AiSuggestionBadgeBackgroundBrush}"
                                                                                BorderBrush="{ThemeResource AiSuggestionBadgeBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                                                                Padding="6,2"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="AI SUGGESTION"
                                                                                       FontSize="10"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{ThemeResource AiSuggestionBadgeTextBrush}" />
                                                                        </Border>

                                                                        <Border Background="{ThemeResource RealBadgeBackgroundBrush}"
                                                                                BorderBrush="{ThemeResource RealBadgeBorderBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="{StaticResource BadgeCornerRadius}"
                                                                                Padding="6,2"
                                                                                VerticalAlignment="Center"
                                                                                Visibility="{x:Bind AcceptedBadgeVisibility, Mode=OneWay}">
                                                                            <TextBlock Text="ACCEPTED"
                                                                                       FontSize="10"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{ThemeResource RealBadgeTextBrush}" />
                                                                        </Border>
                                                                    </StackPanel>

                                                                    <TextBlock Text="{x:Bind Evidence}"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                                               TextWrapping="Wrap" />

                                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                                        <TextBlock Text="{x:Bind SystemDisplay}"
                                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{ThemeResource AppAccentBrush}" />
                                                                        <TextBlock Text="{x:Bind AverageLaborHoursDisplay}"
                                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                                   Visibility="{x:Bind AverageLaborHoursVisibility}" />
                                                                        <TextBlock Text="{x:Bind LastDoneAtDisplay}"
                                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                                   Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                                   Visibility="{x:Bind LastDoneAtVisibility}" />
                                                                    </StackPanel>
                                                                </StackPanel>

                                                                <!-- Accept / Use This Repair Action Button -->
                                                                <Button Grid.Column="2"
                                                                        Style="{StaticResource ActionTouchButtonStyle}"
                                                                        VerticalAlignment="Center"
                                                                        Tag="{x:Bind}"
                                                                        Click="OnAcceptRecommendationButtonClick">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE73E;" FontSize="15" />
                                                                        <TextBlock Text="{x:Bind AcceptButtonLabel, Mode=OneWay}" FontWeight="Bold" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- =============================================================== -->
                <!-- 3F. PHASE 6: OSCILLOSCOPE SCREEN (ADR-011)                      -->
                <!-- 4-channel automotive workflow: Device picker, Guided Tests      -->
                <!-- (Safety Warnings FIRST), Channel setup bar (CH1–CH4), Timebase/ -->
                <!-- Sample rate/Trigger, Off-UI-thread decimated Waveform Grid with -->
                <!-- Cursors & Zoom/Pan, Reference Overlay, Deterministic            -->
                <!-- WaveformMath + WaveformComparer verdicts, and .wfm Work Order   -->
                <!-- Library persistence.                                            -->
                <!-- =============================================================== -->
                <!-- Bench-scope layout: toolbar (Run/Stop, timebase, trigger, tools) across the top,
                     channel tiles and tool palette down the left, full-size graticule with A/B axes,
                     and a bottom panel for measurements, rulers, guided tests and the waveform library. -->
                <Grid Grid.Row="2"
                      Background="{ThemeResource ScopeChromeBrush}"
                      Visibility="{x:Bind ViewModel.ScopeViewVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: scope toolbar -->
                    <Grid Grid.Row="0"
                          Background="{ThemeResource ScopeToolbarBrush}"
                          BorderBrush="{ThemeResource ScopeTileBorderBrush}"
                          BorderThickness="0,0,0,1"
                          Padding="8,6"
                          ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Run / Stop -->
                                <Button Width="132" Height="58"
                                        Background="{ThemeResource ScopeRunBrush}" Foreground="White" BorderThickness="0"
                                        CornerRadius="4"
                                        Command="{x:Bind ViewModel.RunScopeCommand}"
                                        Visibility="{x:Bind ViewModel.ScopeRunButtonVisibility, Mode=OneWay}"
                                        AutomationProperties.Name="Run capture">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE768;" FontSize="18" />
                                        <TextBlock Text="Run" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                                <Button Width="132" Height="58"
                                        Background="{ThemeResource ScopeStopBrush}" Foreground="White" BorderThickness="0"
                                        CornerRadius="4"
                                        Command="{x:Bind ViewModel.StopScopeCaptureCommand}"
                                        Visibility="{x:Bind ViewModel.ScopeStopButtonVisibility, Mode=OneWay}"
                                        AutomationProperties.Name="Stop capture">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE71A;" FontSize="18" />
                                        <TextBlock Text="Stop" FontSize="16" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- Timebase tile -->
                                <Grid Width="236" Height="58" Background="{ThemeResource ScopeTileBrush}"
                                      BorderBrush="{ThemeResource ScopeTileBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource ScopeStepperButtonStyle}" Content="&#x2212;"
                                            Command="{x:Bind ViewModel.ScopeTimebaseStepDownCommand}"
                                            AutomationProperties.Name="Faster timebase" />
                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8,2"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="Timebase and sample rate">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Timebase" FontSize="{StaticResource FontSizeSmall}" />
                                            <TextBlock Text="{x:Bind ViewModel.ScopeSampleRateDisplay, Mode=OneWay}"
                                                       FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource ScopeAxisTextBrush}" />
                                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ScopeTimebaseShortDisplay, Mode=OneWay}"
                                                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Width="260" Spacing="8">
                                                    <ComboBox HorizontalAlignment="Stretch" MinHeight="{StaticResource MinTouchSize}"
                                                              Header="Timebase (s/div)"
                                                              ItemsSource="{x:Bind ViewModel.ScopeTimebaseOptions}"
                                                              SelectedItem="{x:Bind ViewModel.SelectedScopeTimebaseOption, Mode=TwoWay}" />
                                                    <ComboBox HorizontalAlignment="Stretch" MinHeight="{StaticResource MinTouchSize}"
                                                              Header="Sample rate"
                                                              ItemsSource="{x:Bind ViewModel.ScopeSampleRateOptions}"
                                                              SelectedItem="{x:Bind ViewModel.SelectedScopeSampleRateOption, Mode=TwoWay}" />
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeTotalWindowDisplay, Mode=OneWay}"
                                                               FontSize="{StaticResource FontSizeSmall}"
                                                               Foreground="{ThemeResource AppTextSecondaryBrush}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource ScopeStepperButtonStyle}" Content="+"
                                            Command="{x:Bind ViewModel.ScopeTimebaseStepUpCommand}"
                                            AutomationProperties.Name="Slower timebase" />
                                </Grid>

                                <!-- Trigger tile -->
                                <Grid Width="236" Height="58" Background="{ThemeResource ScopeTileBrush}"
                                      BorderBrush="{ThemeResource ScopeTileBorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource ScopeStepperButtonStyle}" Content="&#x2212;"
                                            Command="{x:Bind ViewModel.ScopeTriggerLevelDownCommand}"
                                            AutomationProperties.Name="Lower trigger level" />
                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8,2"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="Trigger setup">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Trigger" FontSize="{StaticResource FontSizeSmall}" />
                                            <TextBlock Text="{x:Bind ViewModel.ScopeTriggerSummary, Mode=OneWay}"
                                                       FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource ScopeAxisTextBrush}" />
                                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ScopeTriggerLevelDisplay, Mode=OneWay}"
                                                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Width="260" Spacing="8">
                                                    <ComboBox HorizontalAlignment="Stretch" MinHeight="{StaticResource MinTouchSize}"
                                                              Header="Trigger edge"
                                                              ItemsSource="{x:Bind ViewModel.ScopeTriggerModes}"
                                                              SelectedItem="{x:Bind ViewModel.ScopeTriggerMode, Mode=TwoWay}" />
                                                    <ComboBox HorizontalAlignment="Stretch" MinHeight="{StaticResource MinTouchSize}"
                                                              Header="Trigger channel (1 = A … 4 = D)"
                                                              ItemsSource="{x:Bind ViewModel.ScopeTriggerChannels}"
                                                              SelectedItem="{x:Bind ViewModel.ScopeTriggerChannel, Mode=TwoWay}" />
                                                    <NumberBox MinHeight="{StaticResource MinTouchSize}"
                                                               Header="Trigger level (V)"
                                                               SpinButtonPlacementMode="Inline"
                                                               Value="{x:Bind ViewModel.ScopeTriggerLevelVolts, Mode=TwoWay}" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource ScopeStepperButtonStyle}" Content="+"
                                            Command="{x:Bind ViewModel.ScopeTriggerLevelUpCommand}"
                                            AutomationProperties.Name="Raise trigger level" />
                                </Grid>

                                <!-- Waveform buffer tile (10D.1): step through the last N captures -->
                                <Grid Width="200" Height="58" Background="{ThemeResource ScopeTileBrush}"
                                      BorderBrush="{ThemeResource ScopeTileBorderBrush}" BorderThickness="1" CornerRadius="4"
                                      ToolTipService.ToolTip="{x:Bind ViewModel.ScopeBufferDetailText, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource ScopeStepperButtonStyle}" Content="&#x2039;"
                                            Command="{x:Bind ViewModel.ScopeBufferPreviousCommand}"
                                            AutomationProperties.Name="Previous capture in buffer" />
                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8,2"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            AutomationProperties.Name="Waveform buffer">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Waveform buffer" FontSize="{StaticResource FontSizeSmall}" />
                                            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ScopeBufferPositionText, Mode=OneWay}"
                                                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <StackPanel Width="280" Spacing="8">
                                                    <TextBlock Text="{x:Bind ViewModel.ScopeBufferDetailText, Mode=OneWay}"
                                                               TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                                Command="{x:Bind ViewModel.ScopeBufferFirstCommand}" Content="Oldest" />
                                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                                Command="{x:Bind ViewModel.ScopeBufferLastCommand}" Content="Newest" />
                                                        <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                                Command="{x:Bind ViewModel.ClearScopeBufferCommand}" Content="Clear" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource ScopeStepperButtonStyle}" Content="&#x203A;"
                                            Command="{x:Bind ViewModel.ScopeBufferNextCommand}"
                                            AutomationProperties.Name="Next capture in buffer" />
                                </Grid>

                                <Rectangle Width="1" Margin="4,6" Fill="{ThemeResource ScopeTileBorderBrush}" />

                                <!-- Auto setup (10D.1): range, timebase, sample rate and trigger from the signal -->
                                <Button Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72"
                                        Command="{x:Bind ViewModel.RunScopeAutoSetupCommand}"
                                        ToolTipService.ToolTip="Measure the signal and set range, timebase and trigger"
                                        AutomationProperties.Name="Auto setup">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE945;" FontSize="22"
                                                  Foreground="{ThemeResource ScopeStepperBrush}" />
                                        <TextBlock Text="Auto setup" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72"
                                        AutomationProperties.Name="Device">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE703;" FontSize="22"
                                                  Foreground="{ThemeResource ScopeStepperBrush}" />
                                        <TextBlock Text="Device" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedLeft">
                                            <StackPanel Width="360" Spacing="8">
                                                <TextBlock Text="Scope device" FontWeight="Bold" />
                                                <ComboBox HorizontalAlignment="Stretch" MinHeight="{StaticResource MinTouchSize}"
                                                          Header="Hardware or simulator"
                                                          ItemsSource="{x:Bind ViewModel.AvailableScopeDevices, Mode=OneWay}"
                                                          SelectedItem="{x:Bind ViewModel.SelectedScopeDevice, Mode=TwoWay}" />
                                                <TextBlock Text="{x:Bind ViewModel.ScopeConnectionStatusText, Mode=OneWay}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{ThemeResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                            Command="{x:Bind ViewModel.DiscoverScopeDevicesCommand}" Content="Discover" />
                                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                            Command="{x:Bind ViewModel.OpenSelectedScopeDeviceCommand}"
                                                            Content="{x:Bind ViewModel.ScopeConnectButtonText, Mode=OneWay}" />
                                                    <Button Style="{StaticResource ActionTouchButtonStyle}"
                                                            Command="{x:Bind ViewModel.DisconnectScopeDeviceCommand}" Content="Disconnect" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                                <Button Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72" Command="{x:Bind ViewModel.ToggleScopePanelCommand}" CommandParameter="Guided"
                                        AutomationProperties.Name="Guided tests">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8FD;" FontSize="22"
                                                  Foreground="{ThemeResource ScopeStepperBrush}" />
                                        <TextBlock Text="Guided tests" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72" Command="{x:Bind ViewModel.ToggleScopePanelCommand}" CommandParameter="OneTap"
                                        AutomationProperties.Name="One-tap tests">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE945;" FontSize="22"
                                                  Foreground="{ThemeResource ScopeStepperBrush}" />
                                        <TextBlock Text="One-tap tests" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72" Command="{x:Bind ViewModel.ToggleScopePanelCommand}" CommandParameter="Library"
                                        AutomationProperties.Name="Waveform library">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE8F1;" FontSize="22"
                                                  Foreground="{ThemeResource ScopeStepperBrush}" />
                                        <TextBlock Text="Waveform library" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72" Command="{x:Bind ViewModel.ToggleScopePanelCommand}" CommandParameter="Measurements"
                                        AutomationProperties.Name="Measurements">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE9D9;" FontSize="22"
                                                  Foreground="{ThemeResource ScopeStepperBrush}" />
                                        <TextBlock Text="Measurements" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72" Command="{x:Bind ViewModel.ToggleScopePanelCommand}" CommandParameter="Rulers"
                                        AutomationProperties.Name="Rulers">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xED5E;" FontSize="22"
                                                  Foreground="{ThemeResource ScopeStepperBrush}" />
                                        <TextBlock Text="Rulers" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72" Command="{x:Bind ViewModel.SaveScopeCaptureToWorkOrderCommand}"
                                        AutomationProperties.Name="Save to WO">
                                    <StackPanel Spacing="3">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE74E;" FontSize="22"
                                                  Foreground="{ThemeResource ScopeStepperBrush}" />
                                        <TextBlock Text="Save to WO" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Full screen (10D.1j): own column so it never scrolls away in a small window; Esc or F11 also leaves it -->
                        <Button Grid.Column="1" Style="{StaticResource ScopeToolTileButtonStyle}" MinWidth="72" Command="{x:Bind ViewModel.ToggleScopeFullScreenCommand}"
                                AutomationProperties.Name="{x:Bind ViewModel.ScopeFullScreenButtonText, Mode=OneWay}"
                                ToolTipService.ToolTip="Full screen trace (F11; Esc to leave)">
                            <StackPanel Spacing="3">
                                <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="{x:Bind ViewModel.ScopeFullScreenGlyph, Mode=OneWay}" FontSize="22"
                                          Foreground="{ThemeResource ScopeStepperBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.ScopeFullScreenButtonText, Mode=OneWay}" FontSize="{StaticResource FontSizeBadge}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Provenance badge and device name -->
                        <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="{ThemeResource SimBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource SimBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource BadgeCornerRadius}"
                                    Padding="8,2"
                                    HorizontalAlignment="Right"
                                    Visibility="{x:Bind ViewModel.ScopeSimulatedBadgeVisibility, Mode=OneWay}">
                                <TextBlock Text="SIMULATED" FontSize="{StaticResource FontSizeBadge}" FontWeight="Bold"
                                           Foreground="{ThemeResource SimBadgeTextBrush}" />
                            </Border>
                            <Border Background="{ThemeResource RealBadgeBackgroundBrush}"
                                    BorderBrush="{ThemeResource RealBadgeBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource BadgeCornerRadius}"
                                    Padding="8,2"
                                    HorizontalAlignment="Right"
                                    Visibility="{x:Bind ViewModel.ScopeRealBadgeVisibility, Mode=OneWay}">
                                <TextBlock Text="REAL HARDWARE" FontSize="{StaticResource FontSizeBadge}" FontWeight="Bold"
                                           Foreground="{ThemeResource RealBadgeTextBrush}" />
                            </Border>
                            <TextBlock Text="{x:Bind ViewModel.ScopeDeviceName, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{ThemeResource ScopeAxisTextBrush}"
                                       MaxWidth="220" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: mandatory safety warnings, shown before probing or capturing (ADR-011 §7 / AGENTS.md Rule 6) -->
                    <Grid Grid.Row="1" Margin="8,8,8,0">
                        <!-- 2. MANDATORY SAFETY WARNINGS BANNER — SHOWN FIRST BEFORE PROCEDURE & CAPTURE (ADR-011 §7 / AGENTS.md Rule 6) -->
                        <Border Background="{ThemeResource SafetyWarningBannerBackgroundBrush}"
                                BorderBrush="{ThemeResource SafetyWarningBannerBorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Padding="16,12"
                                Visibility="{x:Bind ViewModel.ScopeSafetyWarningsVisibility, Mode=OneWay}">
                            <StackPanel Spacing="8">
                                <!-- Header: full list until the technician confirms they have read it (button at the top so it is always reachable) -->
                                <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.ScopeSafetyWarningsFullVisibility, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontFamily="{StaticResource IconFontFamily}"
                                                  Glyph="&#xE7BA;"
                                                  FontSize="{StaticResource FontSizeSubtitle}"
                                                  Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                        <TextBlock Text="MANDATORY SAFETY WARNINGS — READ &amp; FOLLOW BEFORE PROBING OR CAPTURING"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="Bold" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SafetyWarningBannerTextBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource ActionTouchButtonStyle}"
                                            Command="{x:Bind ViewModel.AcknowledgeScopeSafetyWarningsCommand}"
                                            AutomationProperties.Name="I have read these safety warnings">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontFamily="{StaticResource IconFontFamily}" Glyph="&#xE73E;" FontSize="16" />
