<ContentDialog
    x:Class="GseTechPro.App.VehicleSelectorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    PrimaryButtonText="Save"
    CloseButtonText="Close"
    DefaultButton="Primary"
    FontFamily="{StaticResource AppFontFamily}">

    <ContentDialog.Resources>
        <!-- 44 px minimum touch targets for the dialog's own buttons. -->
        <Style x:Key="VehicleSelectorSaveButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="MinHeight" Value="{StaticResource MinTouchSize}" />
            <Setter Property="MinWidth" Value="{StaticResource MinTouchSize}" />
            <Setter Property="Padding" Value="{StaticResource TouchButtonPadding}" />
        </Style>
        <Style x:Key="VehicleSelectorCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="{StaticResource MinTouchSize}" />
            <Setter Property="MinWidth" Value="{StaticResource MinTouchSize}" />
            <Setter Property="Padding" Value="{StaticResource TouchButtonPadding}" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="8" MinWidth="{StaticResource VehicleSelectorDialogWidth}">
        <Pivot x:Name="SelectorPivot" Height="{StaticResource VehicleSelectorListHeight}">
            <PivotItem Header="Years" AutomationProperties.Name="Years tab">
                <ListView
                    x:Name="YearsList"
                    AutomationProperties.Name="Model years"
                    ItemsSource="{x:Bind Model.Years}"
                    SelectedIndex="{x:Bind Model.SelectedYearIndex, Mode=TwoWay}"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource VehicleSelectorItemStyle}" />
            </PivotItem>
            <PivotItem Header="Makes" AutomationProperties.Name="Makes tab">
                <ListView
                    x:Name="MakesList"
                    AutomationProperties.Name="Makes"
                    ItemsSource="{x:Bind Model.Makes}"
                    SelectedIndex="{x:Bind Model.SelectedMakeIndex, Mode=TwoWay}"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource VehicleSelectorItemStyle}" />
            </PivotItem>
            <PivotItem Header="Models" AutomationProperties.Name="Models tab">
                <ListView
                    x:Name="ModelsList"
                    AutomationProperties.Name="Models"
                    ItemsSource="{x:Bind Model.Models}"
                    SelectedIndex="{x:Bind Model.SelectedModelIndex, Mode=TwoWay}"
                    SelectionMode="Single"
                    ItemContainerStyle="{StaticResource VehicleSelectorItemStyle}" />
            </PivotItem>
        </Pivot>

        <TextBlock
            Text="{x:Bind Model.SelectionSummary, Mode=OneWay}"
            Foreground="{ThemeResource AppTextSecondaryBrush}"
            FontSize="{StaticResource FontSizeBody}"
            TextWrapping="Wrap"
            AutomationProperties.Name="Current vehicle selection" />
    </StackPanel>
</ContentDialog>
